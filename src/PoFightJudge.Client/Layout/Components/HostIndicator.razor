@* Who is hosting, and whether they are talking right now. The level comes from the audio graph, not from .NET. *@
<div class="host po-glass @(Speaking ? "host--speaking" : null)" data-host="@Persona.ToString().ToLowerInvariant()">
    <span class="face" aria-hidden="true">@Host.Emoji</span>
    <span class="name">@Host.Name</span>
    <span class="state po-muted">@(Speaking ? "speaking" : "listening")</span>
</div>

@code {
    [Parameter] public HostPersonaId Persona { get; set; } = HostPersonaId.Referee;

    [Parameter] public bool Speaking { get; set; }

    private HostPersonaDto Host => HostPersonaCatalogue.For(Persona);

    private HostPersonaId? _drawnPersona;
    private bool _drawnSpeaking;

    /// <summary>Two facts, one of which never changes during a fight. The voice level is a CSS variable, not a render.</summary>
    protected override bool ShouldRender() => _drawnPersona != Persona || _drawnSpeaking != Speaking;

    protected override void OnAfterRender(bool firstRender)
    {
        _drawnPersona = Persona;
        _drawnSpeaking = Speaking;
    }
}
