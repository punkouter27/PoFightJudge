@using PoFightJudge.Client.Features.Stats
@* One of the top three on the card, as a trading card with a holographic finish. The foil follows the pointer (or the
   tilt of the phone) through --mx and --my, which PoFx.holo publishes on it; without the script it is a card. *@
<article class="foil po-card @Place" data-tag="@Fighter.Tag">
    <span class="rank po-display">#@Rank</span>
    <span class="tag po-display">@Fighter.Tag</span>
    @if (!string.Equals(Fighter.DisplayName, Fighter.Tag, StringComparison.Ordinal))
    {
        <span class="name">@Fighter.DisplayName</span>
    }
    <RankBadge Rating="@Fighter.Rating" Fights="@Fighter.Fights" />
    <dl class="numbers">
        <div><dt class="po-eyebrow">Rating</dt><dd class="po-display po-num">@Fighter.Rating</dd></div>
        <div><dt class="po-eyebrow">Record</dt><dd class="po-display po-num">@Fighter.Wins–@Fighter.Losses</dd></div>
    </dl>
    <FormSparkline Scores="@Fighter.Form" />
</article>

@code {
    [Parameter, EditorRequired] public FighterStatsDto Fighter { get; set; } = default!;

    /// <summary>Where they stand: 1, 2 or 3.</summary>
    [Parameter] public int Rank { get; set; } = 1;

    private string Place => Rank switch
    {
        1 => "first",
        2 => "second",
        _ => "third",
    };

    /// <summary>The top of the card: the ranked fighters by rating, best first, at most three. Nobody unranked is on it.</summary>
    public static IReadOnlyList<FighterStatsDto> Podium(IEnumerable<FighterStatsDto> roster) =>
        [.. roster.Where(f => RankTiers.For(f.Rating, f.Fights) != Tier.Unranked).OrderByDescending(f => f.Rating).ThenBy(f => f.Tag, StringComparer.Ordinal).Take(3)];
}
