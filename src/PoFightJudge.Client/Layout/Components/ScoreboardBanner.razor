@* Who is arguing, what each of them has done before, and who has the floor right now. *@
<section class="scoreboard" aria-label="Who is arguing">
    <div class="side p1 po-glass @(HasFloor(Speaker.Player1) ? "side--speaking" : null)" data-tag="@Player1">
        <span class="tag po-display">@Player1</span>
        @if (Player1Stance is { } one)
        {
            <span class="po-chip stance stance--@(one.ToString().ToLowerInvariant())">@one.Label()</span>
        }
        <span class="record po-muted">@Record(Player1Record)</span>
        @if (HasFloor(Speaker.Player1))
        {
            <span class="floor floor--now po-display">Your turn — talk</span>
        }
        else
        {
            <span class="floor po-muted">@Waiting</span>
        }
    </div>

    <div class="middle">
        @if (HostSpeaking)
        {
            @* No meter while the host talks: a bar twitching under somebody's name reads as "keep going". *@
            <span class="floor po-muted">The host has the floor</span>
        }
        else
        {
            <LevelMeter Listening="@Listening" Caption="@(Speaking is null ? "Microphone" : $"{NameOf(Speaking.Value)} speaking")" />
        }
    </div>

    <div class="side p2 po-glass @(HasFloor(Speaker.Player2) ? "side--speaking" : null)" data-tag="@Player2">
        <span class="tag po-display">@Player2</span>
        @if (Player1Stance is { } first)
        {
            <span class="po-chip stance stance--@(first.Opposite().ToString().ToLowerInvariant())">@first.Opposite().Label()</span>
        }
        <span class="record po-muted">@Record(Player2Record)</span>
        @if (HasFloor(Speaker.Player2))
        {
            <span class="floor floor--now po-display">Your turn — talk</span>
        }
        else
        {
            <span class="floor po-muted">@Waiting</span>
        }
    </div>
</section>

@code {
    [Parameter] public string Player1 { get; set; } = "Fighter one";

    [Parameter] public string Player2 { get; set; } = "Fighter two";

    /// <summary>Whether fighter one is for the topic or against it (fighter two is the opposite); null without sides.</summary>
    [Parameter] public Stance? Player1Stance { get; set; }

    /// <summary>What is known about each of them, when the roster has been read.</summary>
    [Parameter] public FighterDto? Player1Record { get; set; }

    [Parameter] public FighterDto? Player2Record { get; set; }

    [Parameter] public Speaker? Speaking { get; set; }

    [Parameter] public bool Listening { get; set; }

    /// <summary>The host is talking. Whoever's turn it nominally is, nobody has the floor while that is true.</summary>
    [Parameter] public bool HostSpeaking { get; set; }

    /// <summary>
    /// What is worth saying about this tag. A fighter created for this fight has never argued before; one who has
    /// gets their name, unless their name is just the tag again — printing that twice says nothing.
    /// </summary>
    /// <summary>What the side that does not have the floor is told: whose turn it is, not merely that it is not theirs.</summary>
    private string Waiting =>
        HostSpeaking ? "The host has the floor"
        : Speaking is null ? "waiting"
        : $"{NameOf(Speaking.Value)} has the floor";

    private bool HasFloor(Speaker side) => !HostSpeaking && Speaking == side;

    private string NameOf(Speaker speaker) => speaker == Speaker.Player1 ? Player1 : Player2;

    private static string Record(FighterDto? fighter) =>
        fighter is null || fighter.CreatedAt == fighter.LastSeenAt ? "First fight"
        : string.Equals(fighter.DisplayName, fighter.Tag, StringComparison.Ordinal) ? "Argued here before"
        : fighter.DisplayName;

    private string? _drawn;

    /// <summary>
    /// Seven parameters, and a live fight publishes a snapshot that touches none of them several times a second.
    /// What is actually on screen is the two names, the two records, who has the floor and whether the meter is
    /// live — so that is what is compared, rather than the snapshot that carried it.
    /// </summary>
    protected override bool ShouldRender() => !string.Equals(OnScreen, _drawn, StringComparison.Ordinal);

    protected override void OnAfterRender(bool firstRender) => _drawn = OnScreen;

    private string OnScreen =>
        string.Join('|', Player1, Player2, Record(Player1Record), Record(Player2Record), Speaking, Listening, HostSpeaking);
}
