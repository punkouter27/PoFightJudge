@using System.Globalization
@inject Viewport Viewport
@* The leaderboard: people and the cast together. Rank is the row's place in the order the server returned, not a stored number. *@

<div class="po-scope">
@if (Rows.Count == 0)
{
    <EmptyState Icon="leaderboard" Title="Nothing to rank" Text="@Empty" />
}
else
{
    <RadzenDataGrid Data="@_ranked" TItem="Placed" AllowSorting="false" Density="Density.Compact" class="board"
                    RowClick="@(args => Open(args.Data))"
                    RowRender="@(args => args.Attributes["class"] = OnOpen.HasDelegate ? "openable" : string.Empty)">
        <Columns>
            @* Four columns, about 18rem fixed beside the name (12rem on a phone, where the tier badge gives way to the
               number): a narrow window does not scroll sideways, and the name keeps its room. The win rate is a
               number in the record rather than a bar of its own. *@
            <RadzenDataGridColumn TItem="Placed" Title="#" Width="@(Viewport.IsPhone ? "2rem" : "2.5rem")" Property="@nameof(Placed.Rank)" />
            <RadzenDataGridColumn TItem="Placed" Title="Who">
                <Template Context="placed">
                    @placed.Row.DisplayName
                    @if (!placed.Row.IsPerson)
                    {
                        @* People and the cast share the board; the cast is marked so a persona is not taken for somebody. *@
                        <span class="po-chip cast-mark">cast</span>
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Placed" Title="Rating" Width="@(Viewport.IsPhone ? "4rem" : "8rem")">
                <Template Context="placed">
                    <strong>@placed.Row.Rating</strong>
                    @if (!Viewport.IsPhone)
                    {
                        <RankBadge Rating="@placed.Row.Rating" Fights="@placed.Row.Matches" />
                    }
                </Template>
            </RadzenDataGridColumn>
            <RadzenDataGridColumn TItem="Placed" Title="Record" Width="@(Viewport.IsPhone ? "6.5rem" : "7.5rem")">
                <Template Context="placed">
                    @placed.Row.Wins of @placed.Row.Matches
                    <span class="po-muted rate-value">@((placed.Row.WinRate * 100).ToString("0", CultureInfo.CurrentCulture))%</span>
                </Template>
            </RadzenDataGridColumn>
        </Columns>
    </RadzenDataGrid>
}
</div>

@code {
    private IReadOnlyList<Placed> _ranked = [];

    [Parameter, EditorRequired] public IReadOnlyList<LeaderboardRowDto> Rows { get; set; } = [];

    /// <summary>What to say when nobody qualifies, in the words of whichever board this is.</summary>
    [Parameter] public string Empty { get; set; } = "Nobody has argued enough to be ranked.";

    /// <summary>Set only when there is somewhere for a row to lead; without it the rows are not clickable.</summary>
    [Parameter] public EventCallback<string> OnOpen { get; set; }

    protected override void OnParametersSet() =>
        _ranked = [.. Rows.Select((row, index) => new Placed(index + 1, row))];

    private Task Open(Placed? placed) =>
        placed is not null && OnOpen.HasDelegate ? OnOpen.InvokeAsync(placed.Row.Id) : Task.CompletedTask;

    /// <summary>A row with the place it came in, so the grid does not have to search the list for every cell.</summary>
    public sealed record Placed(int Rank, LeaderboardRowDto Row);
}
