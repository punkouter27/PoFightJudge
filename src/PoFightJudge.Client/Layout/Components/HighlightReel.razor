@using PoFightJudge.Client.Features.Stats
@using PoFightJudge.Shared.Identifiers
@inject IApiClient Api
@inject SaveInterop Save
@inject IJSRuntime JS
@* The moments worth hearing again, cut out of the recording on demand. *@
<div class="reel">
    @if (Highlights.Count == 0)
    {
        <p class="po-muted">No moment stood out enough to keep.</p>
    }
    else
    {
        @foreach (var (highlight, index) in Highlights.Select((h, i) => (h, i)))
        {
            <article class="moment po-card @(highlight.Speaker == Speaker.Player1 ? "p1" : "p2")" data-index="@index">
                <header>
                    <span class="po-eyebrow">@highlight.Label</span>
                    <span class="po-muted when">@StatFormat.Seconds(highlight.StartSeconds)</span>
                </header>
                <blockquote><p>“@highlight.Quote”</p></blockquote>
                @if (_playing.ContainsKey(index))
                {
                    @* What is being heard, as mountains: PoTerrain decodes the clip and draws it rolling past. *@
                    <canvas class="terrain" aria-hidden="true"></canvas>
                }

                <div class="ways">
                    @if (_playing.TryGetValue(index, out var clip))
                    {
                        <audio controls autoplay src="@clip" class="player" aria-label="@($"{highlight.Label} clip")"></audio>
                    }
                    else
                    {
                        <RadzenButton Text="Hear it" Icon="play_arrow" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                                      Disabled="@(_loading == index)" Click="@(() => PlayAsync(index))" />
                    }
                    <RadzenButton Text="Save it" Icon="download" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                  title="@($"Save the {highlight.Label} clip")" aria-label="@($"Save the {highlight.Label} clip")"
                                  Disabled="@(_loading == index)" Click="@(() => SaveAsync(index, highlight))" />
                </div>
            </article>
        }
    }

    @if (_problem is not null)
    {
        <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => _problem = null)">@_problem</RadzenAlert>
    }
</div>

@code {
    [Parameter, EditorRequired] public MatchId MatchId { get; set; }

    [Parameter] public IReadOnlyList<HighlightDto> Highlights { get; set; } = [];

    /// <summary>What the fight was about, so a saved clip lands with a name that says which argument it is from.</summary>
    [Parameter] public string Topic { get; set; } = string.Empty;

    private readonly Dictionary<int, string> _playing = [];

    /** The clips whose mountains have been asked for, so each is drawn once. */
    private readonly HashSet<int> _drawn = [];
    private int? _loading;
    private string? _problem;

    /// <summary>
    /// Saving takes the same route as playing, for the same reason: the bytes have to be fetched with the caller's
    /// credentials before the browser can be handed anything, so a download link would get a 401 in Production.
    /// </summary>
    private async Task SaveAsync(int index, HighlightDto highlight)
    {
        if (_loading is not null)
        {
            return;
        }

        _loading = index;
        _problem = null;
        try
        {
            var clip = await FetchAsync(index);
            if (clip is null)
            {
                return;
            }

            var name = SaveInterop.FileName(Topic, highlight.Label, "wav");
            if (!await Save.FileAsync(name, "audio/wav", clip))
            {
                _problem = "This browser would not save the clip. Play it and use the player's own menu instead.";
            }
        }
        finally
        {
            _loading = null;
        }
    }

    /// <summary>
    /// A clip that has just started gets its picture: once it is in the page, PoTerrain is pointed at its player and
    /// its canvas, in the colour of whoever said it. Nothing is lost if the browser will not.
    /// </summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        foreach (var index in _playing.Keys.Where(i => !_drawn.Contains(i)).ToList())
        {
            _drawn.Add(index);
            var token = Highlights[index].Speaker == Speaker.Player2 ? "--po-p2" : "--po-p1";
            try
            {
                await JS.InvokeAsync<bool>("PoTerrain.attach", $".moment[data-index='{index}'] audio", $".moment[data-index='{index}'] canvas.terrain", token);
            }
            catch (JSException)
            {
                // No mountains; the player is still there.
            }
        }
    }

    /// <summary>
    /// Plays one moment as its own button would, for the timeline above the reel, which points at them. From outside
    /// the component, so it asks for its own render.
    /// </summary>
    public Task HearAsync(int index) => InvokeAsync(async () =>
    {
        await PlayAsync(index);
        StateHasChanged();
    });

    /// <summary>
    /// The clip is fetched rather than linked: the recording lives in a private container and the route carries the
    /// caller's own credentials, which a plain audio source would not.
    /// </summary>
    private async Task PlayAsync(int index)
    {
        if (_loading is not null)
        {
            return;
        }

        _loading = index;
        _problem = null;
        try
        {
            if (await FetchAsync(index) is { } clip)
            {
                _playing[index] = $"data:audio/wav;base64,{Convert.ToBase64String(clip)}";
            }
        }
        finally
        {
            _loading = null;
        }
    }

    /// <summary>One clip's bytes, or null with the reason already on screen. Shared by hearing it and saving it.</summary>
    private async Task<byte[]?> FetchAsync(int index)
    {
        try
        {
            var clip = await Api.GetClipAsync(MatchId, index);
            if (clip is null || clip.Length == 0)
            {
                _problem = "That moment could not be cut out of the recording.";
                return null;
            }

            return clip;
        }
        catch (ApiException ex)
        {
            _problem = ex.Summary;
            return null;
        }
        catch (HttpRequestException ex)
        {
            _problem = $"The clip could not be fetched ({ex.Message}).";
            return null;
        }
    }
}
