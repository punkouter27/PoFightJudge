@* One fighter's tag, suggested from everyone who has argued before. The tag is the identity a record is kept under. *@
<div class="tag-input" data-name="@Name">
    <RadzenFormField Text="@Label" Variant="Variant.Outlined" class="field">
        <ChildContent>
            <RadzenAutoComplete Data="@Suggestions"
                                TextProperty="@nameof(FighterDto.Tag)"
                                Value="@Tag"
                                Change="@OnTyped"
                                Name="@Name"
                                MaxLength="@Initials.MaxLength"
                                Placeholder="ABC"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                aria-label="@Label" />
        </ChildContent>
        <Helper>
            @if (Error is { Length: > 0 })
            {
                <span class="validation-message">@Error</span>
            }
            else
            {
                <span class="po-muted">Three letters. Everything said here goes on this tag's record.</span>
            }
        </Helper>
    </RadzenFormField>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "Fighter";

    [Parameter, EditorRequired] public string Name { get; set; } = "tag";

    [Parameter] public string Tag { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> TagChanged { get; set; }

    /// <summary>Everyone who has argued before. Empty until the roster exists, which simply means no suggestions.</summary>
    [Parameter] public IReadOnlyList<FighterDto> Known { get; set; } = [];

    /// <summary>The other side's tag, which this one may not be.</summary>
    [Parameter] public string? Excluded { get; set; }

    private string? Error { get; set; }

    private IEnumerable<FighterDto> Suggestions =>
        Known.Where(f => !string.Equals(f.Tag, Excluded, StringComparison.OrdinalIgnoreCase));

    private async Task OnTyped(object? value)
    {
        var typed = value?.ToString() ?? string.Empty;
        var normalized = Initials.Normalize(typed);

        Error = typed.Trim().Length > 0 && !Initials.IsTag(typed) && normalized.Length >= Initials.MaxLength
            ? "A tag is exactly three letters."
            : string.Equals(normalized, Initials.Normalize(Excluded), StringComparison.Ordinal) && normalized.Length > 0
                ? "The other fighter already has that tag."
                : null;

        Tag = normalized;
        await TagChanged.InvokeAsync(normalized);
    }
}
