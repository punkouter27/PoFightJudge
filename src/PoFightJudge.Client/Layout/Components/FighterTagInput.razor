@* One fighter's tag, suggested from everyone who has argued before. The tag is the identity a record is kept under. *@
<div class="tag-input" data-name="@Name">
    <RadzenFormField Text="@Label" Variant="Variant.Outlined" class="field">
        <ChildContent>
            <RadzenAutoComplete Data="@Suggestions"
                                TextProperty="@nameof(FighterDto.Tag)"
                                Value="@Tag"
                                Change="@OnTyped"
                                Name="@Name"
                                MaxLength="@Initials.MaxLength"
                                Placeholder="ABC"
                                FilterCaseSensitivity="FilterCaseSensitivity.CaseInsensitive"
                                aria-label="@Label" />
        </ChildContent>
        <Helper>
            @if (Shown is { } error)
            {
                <span class="validation-message" role="alert">@error</span>
            }
            else
            {
                <span class="po-muted">Three letters. Everything said here goes on this tag's record.</span>
            }
        </Helper>
    </RadzenFormField>
</div>

@code {
    [Parameter, EditorRequired] public string Label { get; set; } = "Fighter";

    [Parameter, EditorRequired] public string Name { get; set; } = "tag";

    [Parameter] public string Tag { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> TagChanged { get; set; }

    /// <summary>Everyone who has argued before. Empty until the roster exists, which simply means no suggestions.</summary>
    [Parameter] public IReadOnlyList<FighterDto> Known { get; set; } = [];

    /// <summary>The other side's tag, which this one may not be; only used to leave it out of the suggestions.</summary>
    [Parameter] public string? Excluded { get; set; }

    /// <summary>
    /// What the setup's validator (Shared <c>CreateFightRequestValidator</c>) says about this tag, or the server's
    /// answer. Shown once there is something to judge — three characters typed, or an answer from the server — so
    /// the first two letters of a tag are not greeted with a complaint about being two letters.
    /// </summary>
    [Parameter] public string? Error { get; set; }

    /// <summary>True to show <see cref="Error"/> whatever has been typed: a refused start, or a server answer.</summary>
    [Parameter] public bool ShowError { get; set; }

    private bool _typed;

    private string? Shown => Error is { Length: > 0 } && (ShowError || (_typed && Tag.Length >= Initials.MaxLength)) ? Error : null;

    private IEnumerable<FighterDto> Suggestions =>
        Known.Where(f => !string.Equals(f.Tag, Excluded, StringComparison.OrdinalIgnoreCase));

    private async Task OnTyped(object? value)
    {
        _typed = true;
        var normalized = Initials.Normalize(value?.ToString());
        Tag = normalized;
        await TagChanged.InvokeAsync(normalized);
    }
}
