@* Who runs a 2P fight: one dropdown in the Settings panel, so the setup screen never asks. Face and name only; the
   panel is a narrow card. *@
<div class="hosts">
    <RadzenFormField Text="Who is hosting?" Variant="Variant.Outlined" class="field">
        <ChildContent>
            <RadzenDropDown TValue="HostPersonaId" Value="@Persona" ValueChanged="@OnPicked" Data="@Hosts"
                            TextProperty="Text" ValueProperty="Id" Name="host" aria-label="Who is hosting?" class="host-list" />
        </ChildContent>
    </RadzenFormField>
</div>

@code {
    /// <summary>Each host as one line: the face and the name.</summary>
    private static readonly IEnumerable<object> Hosts =
        [.. HostPersonaCatalogue.All.Select(h => new { h.Id, Text = $"{h.Emoji} {h.Name}" })];

    [Parameter] public HostPersonaId Persona { get; set; } = HostPersonaId.Referee;

    [Parameter] public EventCallback<HostPersonaId> PersonaChanged { get; set; }

    private Task OnPicked(HostPersonaId picked)
    {
        Persona = picked;
        return PersonaChanged.InvokeAsync(picked);
    }
}
