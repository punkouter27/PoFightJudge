@* How much arguing time is left. Counts down, because that is the number that changes behaviour. *@
@* The label names the thing and stays put. With the seconds in it, it changed every second and a screen reader
   read the clock aloud for the whole fight; the number is in the text for anybody who goes looking. *@
<div class="timer" role="timer" aria-label="Arguing time left">
    <RadzenProgressBar Value="@Percent" Max="100" ShowValue="false"
                       ProgressBarStyle="@(RemainingSeconds <= 15 ? ProgressBarStyle.Danger : ProgressBarStyle.Info)" class="bar" />
    <div class="numbers">
        <span class="left po-display @(Hot ? "hot" : null)">@Clock</span>
        <span class="po-muted">left</span>
    </div>
</div>

@code {
    [Parameter] public int ElapsedSeconds { get; set; }

    [Parameter] public int RemainingSeconds { get; set; }

    private int Total => Math.Max(1, ElapsedSeconds + RemainingSeconds);

    private double Percent => Math.Clamp(100.0 * RemainingSeconds / Total, 0, 100);

    private string Clock => $"{RemainingSeconds / 60}:{RemainingSeconds % 60:00}";

    /// <summary>The last ten seconds, while there are still some: the number starts to come apart.</summary>
    private bool Hot => RemainingSeconds is > 0 and <= 10;

    private int _drawnElapsed = -1;
    private int _drawnRemaining = -1;

    /// <summary>
    /// A live fight publishes a snapshot far more often than a second passes, and this shows seconds. Redrawing on
    /// a snapshot that says the same time is a progress bar and two spans diffed for nothing.
    ///
    /// What was drawn is recorded after the render rather than inside the check: ShouldRender is not called for the
    /// first one, so a check that recorded its own answer would let the second render through unconditionally.
    /// </summary>
    protected override bool ShouldRender() => ElapsedSeconds != _drawnElapsed || RemainingSeconds != _drawnRemaining;

    protected override void OnAfterRender(bool firstRender)
    {
        _drawnElapsed = ElapsedSeconds;
        _drawnRemaining = RemainingSeconds;
    }
}
