@* One persona on the cast: portrait, who they are, how they have done in games, how they lean, their line. Read-only:
   a profile is the default cast or written from play, never edited by hand. *@
<article class="profile po-card @(IsWife ? "p2" : "p1")" data-initials="@Persona.Initials">
    <header>
        @if (Profile.HasFace)
        {
            <RadzenImage Path="@FaceUrl" AlternateText="@DisplayName" class="po-face face" />
        }
        else
        {
            <div class="po-face face face--blank po-display" aria-hidden="true">@Persona.Initials</div>
        }
        <div class="who">
            <h3>@DisplayName</h3>
            <div class="meta">
                <span class="po-chip @(IsWife ? "po-chip--p2" : "po-chip--p1")">@Persona.Initials · @Persona.Role</span>
                @if (Profile.FromFights)
                {
                    @* Read from a real person's own debates, in either engine, and rewritten after each one; the authored cast never carries this. *@
                    <span class="po-chip po-chip--accent" title="Read from what this person actually said, and rewritten after every debate they argue in">From their debates</span>
                }
                @if (!string.IsNullOrWhiteSpace(Persona.Occupation))
                {
                    <span class="po-muted">@Persona.Occupation@(Persona.Age is { } age ? $", {age}" : string.Empty)</span>
                }
            </div>
        </div>
        <div class="actions">
            <RadzenButton Icon="@(_playing ? "graphic_eq" : "volume_up")" Variant="Variant.Text" ButtonStyle="ButtonStyle.Base" Size="ButtonSize.Small"
                          title="Preview voice" aria-label="@($"Preview {Persona.Initials}")" Click="@PreviewAsync" IsBusy="@_previewing" Disabled="@_playing" />
        </div>
    </header>

    @* The stats that move: counted from the games they played, never typed. *@
    <div class="record">
        @if (Profile.Record.Matches == 0)
        {
            <span class="po-muted">No games yet</span>
        }
        else
        {
            <span class="po-num">@Profile.Record.Wins–@Profile.Record.Losses@(Profile.Record.Draws > 0 ? $"–{Profile.Record.Draws}" : string.Empty)</span>
            <span class="po-muted">over @Profile.Record.Matches · rating <span class="po-num">@Profile.Record.Rating</span></span>
            <RankBadge Rating="@Profile.Record.Rating" Fights="@Profile.Record.Matches" />
        }
    </div>

    @* Folded: the four labelled scales were 140 px of every card, and twelve cards made the page 2339 px. The strip
       in the summary keeps their shape on the card — four thin bars in the same order — and opening it gives the
       words. A native details element: it opens from the keyboard and needs no script. *@
    <details class="traits">
        <summary>
            <span class="po-eyebrow">Temperament</span>
            <span class="mini" aria-hidden="true">
                @foreach (var value in Traits)
                {
                    <span class="mini-track"><span class="mini-fill" style="@($"--stat-value:{Math.Clamp(value, 0, 100)}%")"></span></span>
                }
            </span>
        </summary>
        <div class="bars">
            <StatBar LeftLabel="Logic" RightLabel="Emotion" Value="@Persona.LogicVsEmotion" Color="@Accent" />
            @* The same four scales, the same way round and in the same order everywhere they appear. The patience bar
               used to be drawn backwards under different words, so a slider pushed right moved its bar left. *@
            <StatBar LeftLabel="Impatient" RightLabel="Patient" Value="@Persona.Patience" Color="@Accent" />
            <StatBar LeftLabel="Forgiving" RightLabel="Holds grudges" Value="@Persona.HoldsGrudges" Color="@Accent" />
            <StatBar LeftLabel="Secure" RightLabel="Jealous" Value="@Persona.Jealousy" Color="@Accent" />
        </div>
    </details>

    @if (!string.IsNullOrWhiteSpace(Persona.Philosophy))
    {
        <blockquote class="quote po-muted">“@Persona.Philosophy”</blockquote>
    }

    @if (_preview is not null)
    {
        <div class="preview" role="status">
            <span class="po-chip po-chip--accent">@_preview.Mood</span>
            <p>“@_preview.Line”</p>
        </div>
    }
    @if (_previewError is not null)
    {
        <p class="preview-error po-muted" role="status">@_previewError</p>
    }
</article>

@code {
    [Parameter, EditorRequired] public ProfileDto Profile { get; set; } = default!;

    [Inject] private IApiClient Api { get; set; } = default!;

    [Inject] private AudioInterop Audio { get; set; } = default!;

    [Inject] private SfxInterop Sound { get; set; } = default!;

    /// <summary>Changes whenever the list reloads, so a replaced portrait is not served from the browser cache.</summary>
    [Parameter] public string FaceVersion { get; set; } = string.Empty;

    private CreateProfileRequest Persona => Profile.Persona;

    private bool IsWife => Persona.Role == ProfileRole.Wife;

    private string Accent => IsWife ? "var(--po-p2)" : "var(--po-p1)";

    /// <summary>The four scales in the order the bars draw them.</summary>
    private int[] Traits => [Persona.LogicVsEmotion, Persona.Patience, Persona.HoldsGrudges, Persona.Jealousy];

    private string DisplayName => string.IsNullOrWhiteSpace(Persona.Name) ? Persona.Initials : Persona.Name;

    private string FaceUrl => $"{ApiRoutes.Profiles.Face(Profile.Id)}?v={Uri.EscapeDataString(FaceVersion)}";

    private PreviewLineResponse? _preview;
    private string? _previewError;
    private bool _previewing;
    private bool _playing;

    /// <summary>Generates one in-character line and speaks it, so the persona can be heard without starting a match.</summary>
    private async Task PreviewAsync()
    {
        _previewing = true;
        _previewError = null;
        try
        {
            _preview = await Api.PreviewLineAsync(Persona);
            _previewing = false;
            if (!_preview.Audio.IsEmpty)
            {
                _playing = true;
                StateHasChanged();
                var duration = await Audio.PlayAsync(_preview.Audio);
                await Task.Delay(duration);
            }
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "The API is not answering") is { } why)
        {
            _previewError = why;
        }
        finally
        {
            _previewing = false;
            _playing = false;
        }
    }
}
