@* What the argument is about: the same box, the same hint and the same way out of a blank mind on both channels. *@
@inject IServiceProvider Services
<section class="topic">
    <RadzenFormField Text="@Label" Variant="Variant.Outlined">
        <ChildContent>
            @* Published as it is typed, so nothing is lost by pressing Start without leaving the box first. *@
            <RadzenTextBox Value="@Value" ValueChanged="@TypedAsync" @oninput="@(e => TypedAsync(e.Value?.ToString() ?? string.Empty))"
                           Name="topic" MaxLength="200" Placeholder="@Placeholder" />
        </ChildContent>
        <Helper><span class="po-muted">@Hint</span></Helper>
    </RadzenFormField>

    @* The way out of a blank mind: pull the lever. How hot it runs is a Settings choice (Medium unless changed). *@
    <div class="spin">
        <RadzenButton Text="@(_spinning ? "Spinning…" : "Spin")" Icon="casino" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                      Disabled="@_spinning" Click="@SpinAsync" />
    </div>

    @if (_showing is not null)
    {
        @* Each frame of the reel is a new element, so its slide-in plays again; the landing gets a glow. *@
        <div class="reel @(_spinning ? null : "landed")" aria-hidden="true">
            <span @key="_frame" class="frame">@_showing</span>
        </div>
    }
</section>

@code {
    public enum Heat
    {
        Mild,
        Medium,
        Spicy,
    }

    /// <summary>What there is to argue about, by how hot it runs. The reel only ever shows the heat asked for.</summary>
    public static IReadOnlyDictionary<Heat, string[]> Topics { get; } = new Dictionary<Heat, string[]>
    {
        [Heat.Mild] =
        [
            "turning the heating up", "loading the dishwasher my way", "packing the car the night before",
            "leaving the lights on", "staying in this weekend", "watching my show tonight",
        ],
        [Heat.Medium] =
        [
            "no screens after nine", "visiting my family first this year", "hosting the in-laws at Christmas",
            "letting the anniversary slide", "splitting every bill fifty-fifty", "telling your friend to stop staying over",
        ],
        [Heat.Spicy] =
        [
            "me doing more around the house", "you still texting your ex", "your mother having a say in our life",
            "spending money without asking", "moving for my job", "whoever started it apologising first",
        ],
    };

    /// <summary>How many topics flick past before it lands.</summary>
    private const int Frames = 14;

    [Parameter] public string Value { get; set; } = string.Empty;

    /// <summary>Raised when a spin lands, so the page can deal the sides for the topic it landed on.</summary>
    [Parameter] public EventCallback Spun { get; set; }

    [Parameter] public EventCallback<string> ValueChanged { get; set; }

    [Parameter] public string Label { get; set; } = "What is the fight about?";

    [Parameter] public string Placeholder { get; set; } = "turning the heating up";

    [Parameter] public string Hint { get; set; } = "Leave it blank and they will find something.";

    /// <summary>Asked for rather than injected, like the clock: a page rendered without preferences spins medium.</summary>
    private Heat SpinHeat => (Services.GetService(typeof(Preferences)) as Preferences)?.Heat ?? Heat.Medium;

    /// <summary>Asked for rather than injected: a page rendered without a clock registered still has a topic box.</summary>
    private TimeProvider Clock => Services.GetService(typeof(TimeProvider)) as TimeProvider ?? TimeProvider.System;
    private bool _spinning;
    private string? _showing;
    private int _frame;

    /// <summary>
    /// The run of topics a spin shows, the last being where it lands: all of one heat, never the same one twice in a
    /// row. Public, with the random source passed in, because it is the whole decision.
    /// </summary>
    public static IReadOnlyList<string> Reel(Random random, Heat heat, int frames)
    {
        ArgumentNullException.ThrowIfNull(random);
        var pool = Topics[heat];
        var reel = new List<string>(frames);
        for (var i = 0; i < frames; i++)
        {
            string next;
            do
            {
                next = pool[random.Next(pool.Length)];
            }
            while (reel.Count > 0 && next == reel[^1]);

            reel.Add(next);
        }

        return reel;
    }

    /// <summary>How long frame <paramref name="frame"/> of <paramref name="frames"/> stays up: quick at first, slowing to the landing.</summary>
    public static TimeSpan Pause(int frame, int frames) =>
        TimeSpan.FromMilliseconds(45 + (260 * Math.Pow((double)frame / Math.Max(1, frames - 1), 2.2)));

    /// <summary>Somebody typing has their own topic: the reel, if there was one, has said its piece.</summary>
    private Task TypedAsync(string value)
    {
        _showing = null;
        return PublishAsync(value);
    }

    private Task PublishAsync(string value)
    {
        Value = value ?? string.Empty;
        return ValueChanged.InvokeAsync(Value);
    }

    /// <summary>
    /// Pulls the lever: the reel flicks through topics of the chosen heat, ticking higher as it slows, and lands with
    /// a cue — and the topic it lands on goes into the box.
    /// </summary>
    private async Task SpinAsync()
    {
        if (_spinning)
        {
            return;
        }

        _spinning = true;
        var reel = Reel(Random.Shared, SpinHeat, Frames);
        for (var frame = 0; frame < reel.Count; frame++)
        {
            _showing = reel[frame];
            _frame++;
            StateHasChanged();
            await Services.CueAsync(Sfx.Count, (double)frame / reel.Count);
            await Task.Delay(Pause(frame, reel.Count), Clock);
        }

        _spinning = false;
        await Services.CueAsync(Sfx.Cue);
        await PublishAsync(reel[^1]);
        await Spun.InvokeAsync();
    }
}
