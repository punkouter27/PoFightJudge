@using PoFightJudge.Client.Features.Stats
@* Where somebody's rating sits on the ladder, as a medal. Gold and up catch the light every few seconds. *@
<span class="tier @Css @(Promoted ? "promoted" : null)" title="@Title">
    <RadzenIcon Icon="@(Tier == Tier.Unranked ? "radio_button_unchecked" : "military_tech")" class="medal" />
    <span class="label">@Tier</span>
</span>

@code {
    [Parameter] public int Rating { get; set; }

    [Parameter] public int Fights { get; set; }

    /// <summary>They have climbed since the page was last looked at: the badge says so as it arrives.</summary>
    [Parameter] public bool Promoted { get; set; }

    private Tier Tier => RankTiers.For(Rating, Fights);

    private string Css => Tier switch
    {
        Tier.Bronze => "bronze",
        Tier.Silver => "silver",
        Tier.Gold => "gold",
        Tier.Platinum => "platinum",
        Tier.Diamond => "diamond",
        _ => "unranked",
    };

    private string Title => Tier == Tier.Unranked ? "Not ranked until the first fight" : $"{Tier}, rated {Rating}";
}
