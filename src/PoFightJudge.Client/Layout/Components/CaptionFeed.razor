@implements IDisposable
@inject IJSRuntime JS

@* What is being said, as it is said. A log region so a screen reader reads new lines without stealing focus.

   This component subscribes to its own log rather than being redrawn by the page that owns it: the live API
   rewrites the line being spoken several times a second, and none of those fragments say anything about the phase
   banner, the clock, the host indicator or the scoreboard above it. *@
<section @ref="_container" class="captions po-glass" role="log" aria-live="polite" aria-label="What is being said">
    @if (Log.Lines.Count == 0)
    {
        <p class="po-muted empty">Nothing said yet.</p>
    }
    else
    {
        @foreach (var line in Log.Lines)
        {
            <article class="caption @CssFor(line.Speaker) @(line.Final ? null : "caption--live")" data-speaker="@line.Speaker">
                <span class="who po-eyebrow">@NameFor(line.Speaker)</span>
                <p>@line.Text</p>
            </article>
        }
    }
</section>

@code {
    [Parameter, EditorRequired] public CaptionLog Log { get; set; } = new();

    [Parameter] public string Player1Name { get; set; } = "Fighter one";

    [Parameter] public string Player2Name { get; set; } = "Fighter two";

    [Parameter] public string HostName { get; set; } = "The host";

    /// <summary>The log currently subscribed to, so a changed <c>Log</c> parameter moves the subscription with it.</summary>
    private CaptionLog? _subscribed;

    /// <summary>What is on screen, so a parent redraw that changed nothing here does not become one.</summary>
    private int _drawn = -1;
    private string _names = string.Empty;

    protected override void OnParametersSet()
    {
        if (ReferenceEquals(_subscribed, Log))
        {
            return;
        }

        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnLogChanged;
        }

        _subscribed = Log;
        _subscribed.Changed += OnLogChanged;
    }

    /// <summary>
    /// Recorded after the render rather than inside the check: ShouldRender is not called for the first one, so a
    /// check that recorded its own answer would let the second render through unconditionally.
    /// </summary>
    protected override bool ShouldRender() => Log.Version != _drawn || !string.Equals(Names, _names, StringComparison.Ordinal);

    private ElementReference _container;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _drawn = Log.Version;
        _names = Names;
        try
        {
            await JS.InvokeVoidAsync("PoFx.scrollBottom", _container);
        }
        catch (JSException)
        {
        }
    }

    private string Names => $"{Player1Name}|{Player2Name}|{HostName}";

    public void Dispose()
    {
        if (_subscribed is not null)
        {
            _subscribed.Changed -= OnLogChanged;
            _subscribed = null;
        }
    }

    private void OnLogChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    private string NameFor(Speaker speaker) => speaker switch
    {
        Speaker.Player1 => Player1Name,
        Speaker.Player2 => Player2Name,
        _ => HostName,
    };

    private static string CssFor(Speaker speaker) => speaker switch
    {
        Speaker.Player1 => "p1",
        Speaker.Player2 => "p2",
        _ => "host",
    };
}
