@page "/fight/{MatchIdText}"

<PageTitle>Live · PoFightJudge</PageTitle>

<LeaveGuard @ref="_guard" Active="@(_listening && !_ending)" Title="Leave the fight?"
            Message="The microphone is still open. Leaving now ends the fight where it stands." />

<PageShell Width="PageShell.ShellWidth.Wide" Eyebrow="Channel 2" Title="@Title" Lead="@Lead">
    <Actions>
        <RadzenButton Text="Table mode" Icon="table_restaurant" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                      title="For a phone lying between the two of you: the whole screen, big words, a buzz on each hand-over"
                      Disabled="@(_snapshot is null)" Click="@(() => TableAsync(true))" />
        <RadzenButton Text="Stop the fight" Icon="stop_circle" ButtonStyle="ButtonStyle.Danger"
                      Variant="Variant.Outlined" Disabled="@(_ending || _snapshot is null)" Click="@StopAsync" />
    </Actions>
    <ChildContent>
        @if (_fatal is not null)
        {
            <PageAlert Kind="AlertStyle.Danger" Class="problem">
                <div class="failure">
                    <span>@_fatal</span>
                    <RadzenButton Text="Start another" Icon="mic" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Outlined" Click="@(() => Nav.NavigateTo("fight"))" />
                </div>
            </PageAlert>
        }
        else
        {
            <div class="stage @(_table ? "table" : null)" style="--po-lean: @_floor.Share.ToString("0.000", System.Globalization.CultureInfo.InvariantCulture)">
                @if (_table)
                {
                    <RadzenButton Text="Leave table mode" Icon="close_fullscreen" ButtonStyle="ButtonStyle.Base" Variant="Variant.Flat"
                                  Size="ButtonSize.Small" class="untable" Click="@(() => TableAsync(false))" />
                }

                <section class="bar" aria-label="Where the fight is">
                    <PhaseBanner Phase="@Phase" Topic="@_snapshot?.Topic" />
                    <DebateTimer ElapsedSeconds="@(_snapshot?.DebateElapsedSeconds ?? 0)" RemainingSeconds="@(_snapshot?.DebateRemainingSeconds ?? 0)" />
                    <HostIndicator Persona="@(_snapshot?.Persona ?? HostPersonaId.Referee)" Speaking="@_hostSpeaking" />
                </section>

                <ScoreboardBanner Player1="@Player1" Player2="@Player2"
                                  Player1Record="@_oneRecord" Player2Record="@_twoRecord"
                                  Speaking="@_snapshot?.Speaking" Listening="@_listening" HostSpeaking="@_hostSpeaking"
                                  Player1Stance="@_snapshot?.Player1Stance" />

                <MomentumBar Player1="@Player1" Player2="@Player2" Share="@_floor.Share" />
                <CalmMeter Player1="@Player1" Player2="@Player2" Talk="@_floor" Loud="@_loud" />

                @if (_problem is not null)
                {
                    <RadzenAlert AlertStyle="AlertStyle.Warning" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="true" Close="@(() => _problem = null)" class="problem">@_problem</RadzenAlert>
                }

                @if (_reconnecting)
                {
                    <PageAlert Kind="AlertStyle.Info" Class="problem">
                        The connection dropped. Keep talking — this keeps trying for as long as the page is open.
                    </PageAlert>
                }

                @if (_tape)
                {
                    <TaleOfTheTape Player1="@Player1" Player2="@Player2" One="@_oneStats" Two="@_twoStats" HeadToHead="@_series" OnSkip="@SkipTape" />
                }

                <CaptionFeed Log="@_captions" Player1Name="@Player1" Player2Name="@Player2" HostName="@HostName" />
            </div>
        }
    </ChildContent>
</PageShell>
