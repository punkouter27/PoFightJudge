@page "/v/{Token}"
@attribute [AllowAnonymous]
@layout MainLayout
@inject IApiClient Api
@inject NavigationManager Nav

<PageTitle>@Title · PoFightJudge</PageTitle>

<Backdrop />

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="Somebody sent you this" Title="@Title" Lead="@Lead">
    <ChildContent>
        @if (_loading)
        {
            <LoadingRows Count="2" Label="Opening the ruling" />
        }
        else if (_failed is not null)
        {
            <PageAlert Kind="AlertStyle.Danger">@_failed</PageAlert>
        }
        else if (_shared is null)
        {
            <EmptyState Icon="link_off" Title="This link is not live"
                        Text="It was taken back, or the argument behind it was deleted. Only the person who shared it can put it back.">
                <Action>
                    <RadzenButton Text="Have your own argument" Icon="mic" ButtonStyle="ButtonStyle.Primary" Click="@(() => Nav.NavigateTo(""))" />
                </Action>
            </EmptyState>
        }
        else
        {
            <RulingCard Side1="@_shared.Side1Name" Side2="@_shared.Side2Name" Winner="@(_shared.IsDraw ? null : _shared.Winner)"
                        Summary="@_shared.Verdict" Reasons="@_shared.Reasons">
                <Header>
                    <ModeBadge Mode="@_shared.Mode" />
                    <span class="po-muted">@_shared.StartedAt.LocalDateTime.ToString("d MMMM yyyy", System.Globalization.CultureInfo.CurrentCulture)</span>
                    @if (_shared.IsFake)
                    {
                        <RehearsalChip />
                    }
                </Header>
            </RulingCard>

            <p class="po-muted note">
                This is the ruling only. The recording, the transcript and everything measured about how the two of them
                argued stay with the account that made it.
            </p>

            <div class="go">
                <RadzenButton Text="Argue about something yourself" Icon="mic" ButtonStyle="ButtonStyle.Primary"
                              Size="ButtonSize.Large" Click="@(() => Nav.NavigateTo(""))" />
            </div>
        }
    </ChildContent>
</PageShell>

@code {
    private SharedMatchDto? _shared;
    private bool _loading = true;
    private string? _failed;

    [Parameter] public string Token { get; set; } = string.Empty;

    private string Title => _shared?.Topic is { Length: > 0 } topic ? topic : "A ruling";

    private string Lead => _shared is null
        ? "Looking it up."
        : "The judge's ruling on an argument somebody else had.";

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _failed = null;
        try
        {
            _shared = Token.Length == 0 ? null : await Api.GetSharedAsync(Token);
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "The ruling could not be opened") is { } why)
        {
            // The link may be perfectly good. Saying it "is not live" would send somebody off to ask for another.
            _shared = null;
            _failed = why;
        }
        finally
        {
            _loading = false;
        }
    }
}
