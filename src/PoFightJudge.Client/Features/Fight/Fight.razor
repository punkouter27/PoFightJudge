@page "/2p"
@page "/fight"
@inject IApiClient Api
@inject NavigationManager Nav
@inject SetupMemory Memory
@inject Viewport Viewport
@inject Preferences Prefs
@implements IDisposable

<PageTitle>2P · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="Channel 2P" Title="2P" Lead="@Lead">
    <Actions><ChannelSwitch /></Actions>
    <ChildContent>
        @* A wrapper this page owns, and nothing more (display: contents). Scoped CSS reaches into a child component
           only from an element written here: without one, every ::deep rule for this page matches nothing. *@
        <div class="po-scope">
        @* Three steps on a phone, one screen everywhere else. The whole thing was 1755 px on a phone: the sound check
           sat below the fold, under the button it is supposed to come before, which is how a fight dies on a muted
           headset. RadzenSteps keeps each question to a screen there; a desktop shows who, then what about beside
           the sound check, then the button under both. Each part is written once below and placed either way. *@
        @if (Viewport.IsPhone)
        {
            <RadzenSteps SelectedIndex="@_step" SelectedIndexChanged="@TurnAsync" ShowStepsButtons="true" class="wizard"
                         NextText="Next" PreviousText="Back">
                <Steps>
                    <RadzenStepsItem Text="Who">@WhoStep</RadzenStepsItem>
                    <RadzenStepsItem Text="About" Disabled="@(Problem is not null)">@AboutStep</RadzenStepsItem>
                    <RadzenStepsItem Text="Sound" Disabled="@(Problem is not null)">
                        @SoundStep
                        @StartStep
                    </RadzenStepsItem>
                </Steps>
            </RadzenSteps>
        }
        else
        {
            <div class="sheet">
                @WhoStep
                <div class="pair">
                    @AboutStep
                    @SoundStep
                </div>
                @StartStep
            </div>
        }
        </div>
    </ChildContent>
</PageShell>

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>Who is arguing, and the seat each of them will have in the cast afterwards.</summary>
    private RenderFragment WhoStep => @<div class="step">
<SetupStep Problem="@Problem" Touched="@_touched" PreviewLabel="Who is arguing">
    <Sides>
        <div class="fighter-setup">
            <FighterTagInput Label="Fighter one" Name="player1Tag" Tag="@_one" TagChanged="@OnOneChanged" Known="@_known" Excluded="@_two" />
            @* 2P has no husband or wife. The seat is for afterwards: what they say here becomes a persona that
               CPU and 1P can put in an argument, and those channels pit a husband against a wife. *@
            <div class="seat">
                <span class="po-eyebrow">Argues as</span>
                <RadzenSelectBar @bind-Value="_oneRole" TValue="ProfileRole" Name="player1Role" Size="ButtonSize.Small" aria-label="Fighter one argues as">
                    <Items>
                        <RadzenSelectBarItem Text="Husband" Value="@ProfileRole.Husband" />
                        <RadzenSelectBarItem Text="Wife" Value="@ProfileRole.Wife" />
                    </Items>
                </RadzenSelectBar>
            </div>
        </div>
        <div class="fighter-setup">
            <FighterTagInput Label="Fighter two" Name="player2Tag" Tag="@_two" TagChanged="@OnTwoChanged" Known="@_known" Excluded="@_one" />
            <div class="seat">
                <span class="po-eyebrow">Argues as</span>
                <RadzenSelectBar @bind-Value="_twoRole" TValue="ProfileRole" Name="player2Role" Size="ButtonSize.Small" aria-label="Fighter two argues as">
                    <Items>
                        <RadzenSelectBarItem Text="Husband" Value="@ProfileRole.Husband" />
                        <RadzenSelectBarItem Text="Wife" Value="@ProfileRole.Wife" />
                    </Items>
                </RadzenSelectBar>
            </div>
        </div>
    </Sides>
    <First><FighterCard Tag="@_one" Fighter="@Known(_one)" Stance="@OneStance" /></First>
    <Second><FighterCard Tag="@_two" Fighter="@Known(_two)" IsSecond="true" Stance="@OneStance?.Opposite()" /></Second>
</SetupStep>
        </div>;

    /// <summary>What about. Who hosts is a Settings choice (Referee unless changed), so setup does not ask.</summary>
    private RenderFragment AboutStep => @<div class="step">
@* A spun topic deals the sides as well, so nobody picks the easy one; they can still be changed. *@
<TopicField @bind-Value="_topic" Spun="@(() => _oneStance = Sides.Deal(Random.Shared))" Label="What are you arguing about?" Placeholder="loading the dishwasher my way"
            Hint="Something to be for or against. Leave it blank and the host will ask you both at the top of the show." />
@if (_topic.Trim().Length > 0)
{
    <SideChoice First="@_oneStance" FirstChanged="@(s => _oneStance = s)"
                FirstName="@(_one.Length > 0 ? _one : "Fighter one")" SecondName="@(_two.Length > 0 ? _two : "Fighter two")" />
}
        </div>;

    /// <summary>The microphone, checked before the bell.</summary>
    private RenderFragment SoundStep => @<div class="step">
@* Before the bell, not after it: a fight that dies on a muted headset is three minutes nobody gets back. *@
<MicCheck DeviceId="@_device" DeviceIdChanged="@(d => _device = d)" />
        </div>;

    /// <summary>The button, whatever went wrong last time it was pressed, and what pressing it does.</summary>
    private RenderFragment StartStep => @<div class="step">
@if (_error is not null)
{
    <PageAlert Kind="AlertStyle.Danger" Class="problem">@_error</PageAlert>
}

<div class="go">
    <RadzenButton Text="@(_starting ? "Starting…" : "Start the fight")" Icon="mic"
                  ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large"
                  Disabled="@(Problem is not null || _starting)" Click="@StartAsync" />
</div>

<p class="po-muted note">The microphone only opens once you press start, and it closes when the fight ends. Afterwards each of you becomes a persona in the cast, read from what you said, for the CPU and 1P channels.</p>
        </div>;

    /// <summary>A rotated phone is a different arrangement of the same questions.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewport.Changed -= OnViewportChanged;

    /// <summary>One question gives way to the next, and it sounds like it.</summary>
    private Task TurnAsync(int step)
    {
        _step = step;
        return Services.CueAsync(Sfx.Whoosh);
    }

    private IReadOnlyList<FighterDto> _known = [];
    private string _one = string.Empty;
    private string _two = string.Empty;
    private string _topic = string.Empty;

    /// <summary>Whether fighter one is for the topic or against it; fighter two takes the other side.</summary>
    private Stance _oneStance = Stance.For;

    /// <summary>Fighter one's side, once there is a topic to be for or against.</summary>
    private Stance? OneStance => Sides.For(_topic, _oneStance);
    private ProfileRole _oneRole = ProfileRole.Husband;
    private ProfileRole _twoRole = ProfileRole.Wife;
    private HostPersonaId _persona = HostPersonaId.Referee;

    /// <summary>Which microphone the fight should open, once somebody has picked one. Null means the browser's default.</summary>
    private string? _device;
    private bool _starting;

    /// <summary>Whether a tag has been typed yet. Until one has, what is missing is a hint rather than a warning.</summary>
    private bool _touched;
    private string? _error;

    /// <summary>Which of the three questions is on screen.</summary>
    private int _step;

    private const string Lead = "The two of you, one microphone, and a judge who hosts the argument, questions you both and rules at the end. Your initials are your record: whoever has argued here before is remembered by them.";

    /// <summary>Why the fight cannot start yet, or null when it can.</summary>
    private string? Problem =>
        _one.Length == 0 || _two.Length == 0 ? "Both fighters need a tag."
        : !Initials.IsTag(_one) || !Initials.IsTag(_two) ? "A tag is exactly three letters."
        : string.Equals(_one, _two, StringComparison.OrdinalIgnoreCase) ? "Two people cannot share one tag."
        : null;

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();
        _known = await Api.GetFightersAsync();
        await Prefs.InitializeAsync();
        _persona = Prefs.Host;

        // The same two people argue most nights, and typing both tags again every time is the tax on that. A rematch
        // takes precedence over the remembered card; both leave the topic to whatever it was, blank included.
        // The host is the Settings choice, except on a rematch, which replays the host that fight had.
        var rematch = Memory.FightRematchArmed;
        if (await Memory.FightAsync() is { } card)
        {
            _one = card.One;
            _two = card.Two;
            _topic = card.Topic;
            _oneStance = card.OneStance ?? Stance.For;
            _oneRole = card.OneRole;
            _twoRole = card.TwoRole;
            _persona = rematch ? card.Persona : _persona;
            _device = card.Device is { Length: > 0 } device ? device : null;
        }
    }

    private FighterDto? Known(string tag) =>
        tag.Length == 0 ? null : _known.FirstOrDefault(f => string.Equals(f.Tag, tag, StringComparison.OrdinalIgnoreCase));

    private void OnOneChanged(string tag) => (_one, _touched) = (tag, true);

    private void OnTwoChanged(string tag) => (_two, _touched) = (tag, true);

    private async Task StartAsync()
    {
        if (Problem is not null || _starting)
        {
            return;
        }

        _starting = true;
        _error = null;
        try
        {
            var started = await Api.StartFightAsync(new CreateFightRequest(_persona, _one, _two, _topic.Trim() is { Length: > 0 } t ? t : null, _oneRole, _twoRole, OneStance));
            await Memory.RememberAsync(new FightCard(_one, _two, _topic.Trim(), _oneRole, _twoRole, _persona) { Device = _device ?? string.Empty, OneStance = OneStance });
            Nav.NavigateTo($"fight/{started.MatchId.Value}");
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "The fight could not be started") is { } why)
        {
            _error = why;
        }
        finally
        {
            _starting = false;
        }
    }
}
