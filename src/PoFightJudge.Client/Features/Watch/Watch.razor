@page "/cpu"
@page "/1p"
@page "/watch"
@inject IApiClient Api
@inject SimulationState Simulation
@inject NavigationManager Nav
@inject SetupMemory Memory
@inject FeatureGate Features
@inject Viewport Viewport
@implements IDisposable

<PageTitle>@Channel · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="@($"Channel {Channel}")" Title="@Channel" Lead="@Lead">
    <Actions><ChannelSwitch /></Actions>
    <ChildContent>
        @* A wrapper this page owns, and nothing more (display: contents). Scoped CSS reaches into a child component
           only from an element written here: without one, every ::deep rule for this page matches nothing. *@
        <div class="po-scope">
        @if (_loading)
        {
            <LoadingRows Count="2" Label="Loading the cast" />
        }
        else if (_loadError is not null)
        {
            <PageAlert Kind="AlertStyle.Danger">@_loadError</PageAlert>
        }
        else if (_cast.Count == 0)
        {
            <EmptyState Icon="groups" Title="No cast yet" Text="A watch needs personas to argue. Build one, or load the default cast.">
                <Action>
                    <RadzenButton Text="Go to profiles" Icon="groups" ButtonStyle="ButtonStyle.Primary" Click="@(() => Nav.NavigateTo("profiles"))" />
                </Action>
            </EmptyState>
        }
        else
        {
            @* Two steps on a phone, one screen everywhere else: the cast, then what they argue about. On a phone the
               pickers, two speaker cards and a topic field came to more than the screen, and the button that starts it
               was under the fold; a desktop has the room to ask both questions at once. The two halves are written
               once below and placed either way. *@
            @if (Viewport.IsPhone)
            {
                <RadzenSteps SelectedIndex="@_step" SelectedIndexChanged="@TurnAsync" ShowStepsButtons="true" class="wizard" NextText="Next" PreviousText="Back">
                    <Steps>
                        <RadzenStepsItem Text="Cast">@CastStep</RadzenStepsItem>
                        <RadzenStepsItem Text="About" Disabled="@(Problem is not null)">@AboutStep</RadzenStepsItem>
                    </Steps>
                </RadzenSteps>
            }
            else
            {
                <div class="sheet">
                    @CastStep
                    @AboutStep
                </div>
            }
        }
        </div>
    </ChildContent>
</PageShell>

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>The first question: who is arguing.</summary>
    private RenderFragment CastStep => @<div class="step">
            <SetupStep Problem="@Problem" Touched="@_touched">
                <Sides>
                    @if (IsOnePlayer)
                    {
                        @* One choice: who you are arguing with. Which seat that leaves you is a consequence of
                           their role, not a second question. *@
                        <ProfilePicker Cast="@_cast" AnyRole="true" Caption="Who are you arguing with?"
                                       Side="@_opponent" SideChanged="@OpponentChosenAsync" />
                        <div class="you po-card po-card--quiet">
                            <span class="po-eyebrow">You</span>
                            <span class="seat po-display">@YourSeat</span>
                            <RadzenFormField Text="Your tag" Variant="Variant.Outlined">
                                <ChildContent>
                                    @* Published on every keystroke, so Start answers the tag as it is typed. *@
                                    <RadzenTextBox Value="@_tag" ValueChanged="@TagChangedAsync"
                                                   @oninput="@(e => TagChangedAsync(e.Value?.ToString() ?? string.Empty))"
                                                   Name="yourTag" MaxLength="@Initials.MaxLength" Placeholder="ABC"
                                                   aria-label="Your fighter tag" />
                                </ChildContent>
                                <Helper><span class="po-muted">Three letters. The same tag you argue under, so this counts towards your record.</span></Helper>
                            </RadzenFormField>
                        </div>
                    }
                    else
                    {
                        <ProfilePicker Cast="@_cast" IsWife="false" Excluded="@_wife?.Id" Side="@_husband" SideChanged="@(s => (_husband, _touched) = (s, true))" />
                        <ProfilePicker Cast="@_cast" IsWife="true" Excluded="@_husband?.Id" Side="@_wife" SideChanged="@(s => (_wife, _touched) = (s, true))" />
                    }
                </Sides>
                <First><SpeakerCard Side="@_husband" Profile="@ProfileFor(_husband)" IsWife="false" Stance="@HusbandStance" /></First>
                <Second><SpeakerCard Side="@_wife" Profile="@ProfileFor(_wife)" IsWife="true" Stance="@HusbandStance?.Opposite()" /></Second>
            </SetupStep>
        </div>;

    /// <summary>The second: what about, and the button that starts it.</summary>
    private RenderFragment AboutStep => @<div class="step">
            @* A spun topic deals the sides as well, so nobody picks the easy one; they can still be changed. *@
            <TopicField @bind-Value="_topic" Spun="@(() => _husbandStance = Sides.Deal(Random.Shared))" Placeholder="turning the heating up"
                        Hint="Something to be for or against. Leave it blank and they will find something." />
            @if (_topic.Trim().Length > 0)
            {
                <SideChoice First="@_husbandStance" FirstChanged="@(s => _husbandStance = s)"
                            FirstName="@(_husband?.DisplayName ?? "The husband")" SecondName="@(_wife?.DisplayName ?? "The wife")" />
            }

            <div class="go">
                <RadzenButton Text="Start the argument" Icon="theaters" ButtonStyle="ButtonStyle.Primary" Size="ButtonSize.Large" Disabled="@(Problem is not null)" Click="@Start" />
            </div>
        </div>;

    /// <summary>A rotated phone is a different arrangement of the same two questions.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewport.Changed -= OnViewportChanged;

    /// <summary>One question gives way to the next, and it sounds like it.</summary>
    private Task TurnAsync(int step)
    {
        _step = step;
        return Services.CueAsync(Sfx.Whoosh);
    }

    private List<ProfileDto> _cast = [];
    private MatchSide? _husband;
    private MatchSide? _wife;

    /// <summary>1P only: the profile chosen as the opponent, and the tag the person argues under.</summary>
    private MatchSide? _opponent;
    private string _tag = string.Empty;
    private string _topic = string.Empty;

    /// <summary>Whether the husband is for the topic or against it; the wife takes the other side.</summary>
    private Stance _husbandStance = Stance.For;

    /// <summary>The husband's side, once there is a topic to be for or against.</summary>
    private Stance? HusbandStance => Sides.For(_topic, _husbandStance);
    private bool _loading = true;

    /// <summary>Whether a side or a tag has been chosen by hand yet. Until then, what is missing is a hint, not a warning.</summary>
    private bool _touched;
    private string? _loadError;
    private bool? _channel;

    /// <summary>Which of the two questions is on screen.</summary>
    private int _step;

    /// <summary>
    /// Which channel this is. One screen serves both, because they are the same argument with the same cast and
    /// the same judge — the only difference is whether one of the two seats is you.
    /// </summary>
    private bool IsOnePlayer => Nav.ToBaseRelativePath(Nav.Uri).Split('?', '#')[0].Trim('/').Equals("1p", StringComparison.OrdinalIgnoreCase);

    private string Channel => IsOnePlayer ? "1P" : "CPU vs CPU";

    private string Lead => IsOnePlayer
        ? "You take one seat and a profile takes the other. You speak your turns into the microphone, and it counts towards your record."
        : "Two of your profiles argue it out in their own voices, three rounds each, and a judge calls it on the merits.";

    /// <summary>Whether the server can transcribe a spoken turn at all; without it 1P has nothing to listen with.</summary>
    private bool CanSpeak => Features.Flags.HumanInWatch;

    /// <summary>Which seat the opponent's role leaves for the person. Reads as a statement, because it is one.</summary>
    private string YourSeat => _opponent is null
        ? "whichever side they are not"
        : RoleOf(_opponent) == ProfileRole.Husband ? "the wife" : "the husband";

    /// <summary>Why the match cannot start yet, or null when it can. Doubles as the disabled reason on the button.</summary>
    private string? Problem => IsOnePlayer ? OnePlayerProblem : CpuProblem;

    private string? OnePlayerProblem =>
        !CanSpeak ? "Nothing here can transcribe a spoken turn, so 1P is off."
        : _opponent is null ? "Pick who you are arguing with."
        : !Initials.IsTag(_tag) ? "Say who you are: exactly three letters."
        : string.Equals(Initials.Normalize(_tag), _opponent.Id, StringComparison.OrdinalIgnoreCase) ? "That tag belongs to the profile you are arguing with."
        : null;

    private string? CpuProblem =>
        _husband is null || _wife is null ? "Pick both sides."
        : string.Equals(_husband.Id, _wife.Id, StringComparison.OrdinalIgnoreCase) ? "Both sides cannot be the same."
        : null;

    /// <summary>The profile's role, which is what decides which seat is left for the person.</summary>
    private ProfileRole RoleOf(MatchSide side) =>
        _cast.FirstOrDefault(p => string.Equals(p.Persona.Initials, side.Id, StringComparison.OrdinalIgnoreCase))?.Persona.Role
            ?? ProfileRole.Husband;

    private Task OpponentChosenAsync(MatchSide? side)
    {
        _opponent = side;
        return SeatAsync();
    }

    private Task TagChangedAsync(string value)
    {
        _touched = true;
        _tag = value ?? string.Empty;
        return SeatAsync();
    }

    /// <summary>Puts the opponent in their own seat and the person in the other one.</summary>
    private Task SeatAsync()
    {
        if (_opponent is null)
        {
            _husband = null;
            _wife = null;
            return Task.CompletedTask;
        }

        var tag = Initials.Normalize(_tag);
        var you = tag.Length == 0 ? null : MatchSide.Human(tag);
        if (RoleOf(_opponent) == ProfileRole.Husband)
        {
            _husband = _opponent;
            _wife = you;
        }
        else
        {
            _wife = _opponent;
            _husband = you;
        }

        return Task.CompletedTask;
    }

    /// <summary>
    /// The two channels are the same component under two routes, so moving between them keeps whatever was picked.
    /// A seat taken by a person cannot carry into CPU, and a half-made choice is not worth keeping either way.
    /// </summary>
    protected override void OnParametersSet()
    {
        if (_channel is { } previous && previous != IsOnePlayer)
        {
            _husband = null;
            _wife = null;
            _opponent = null;
            _tag = string.Empty;
            _step = 0;
        }

        _channel = IsOnePlayer;
    }

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();
        try
        {
            if (!Features.Loaded)
            {
                // The gate is loaded in Program.cs; this is the browser that booted while the API was down.
                await Features.LoadAsync();
            }

            _cast = [.. await Api.GetProfilesAsync()];
            await ReopenAsync();
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "Could not load the cast") is { } why)
        {
            _loadError = why;
        }
        finally
        {
            _loading = false;
        }
    }

    private ProfileDto? ProfileFor(MatchSide? side) =>
        side is null || side.IsHuman ? null : _cast.FirstOrDefault(p => string.Equals(p.Persona.Initials, side.Id, StringComparison.OrdinalIgnoreCase));

    /// <summary>
    /// Opens on the last matchup, or on a rematch if one was asked for. Only sides still in the cast are restored:
    /// a profile deleted since then would otherwise arrive as a card naming somebody who is gone.
    /// </summary>
    private async Task ReopenAsync()
    {
        if (await Memory.WatchAsync() is not { } card)
        {
            return;
        }

        _topic = card.Topic;
        _tag = card.Tag;

        var husband = ProfileById(card.Husband);
        var wife = ProfileById(card.Wife);
        if (IsOnePlayer)
        {
            // In 1P only one of the two was a persona; the other seat is the person, and their tag came with the card.
            // Seating is what turns those two into a husband and a wife, so it has to run here as it does on a click.
            _opponent = husband is not null ? SideFor(husband) : wife is not null ? SideFor(wife) : null;
            await SeatAsync();
        }
        else if (husband is not null && wife is not null)
        {
            _husband = SideFor(husband);
            _wife = SideFor(wife);
        }
    }

    private ProfileDto? ProfileById(string initials) =>
        initials.Length == 0 ? null : _cast.FirstOrDefault(p => string.Equals(p.Persona.Initials, initials, StringComparison.OrdinalIgnoreCase));

    private static MatchSide SideFor(ProfileDto profile) => MatchSide.Persona(profile.Persona.Initials, profile.Persona.Name);

    private async Task Start()
    {
        if (Problem is not null)
        {
            return;
        }

        Simulation.Set(_husband!, _wife!, _topic, HusbandStance);
        await Memory.RememberAsync(new WatchCard(
            _husband!.IsHuman ? string.Empty : _husband.Id,
            _wife!.IsHuman ? string.Empty : _wife.Id,
            _topic,
            IsOnePlayer ? Initials.Normalize(_tag) : string.Empty));
        Nav.NavigateTo("watch/play");
    }
}
