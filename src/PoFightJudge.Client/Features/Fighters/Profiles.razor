@page "/profiles"
@inject IApiClient Api
@inject DialogService Dialog
@inject NotificationService Notify
@inject TimeProvider Clock

<PageTitle>Profiles · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Wide" Eyebrow="The cast" Title="Profiles"
           Lead="Every CPU and 1P match is two of these: the default cast, and everybody who has played. Their records come from their games.">
    <Actions>
        @* One wrapping row this page owns: the search takes whatever room the switch leaves, so on a phone the two
           share a line and the buttons take the next, rather than four lines of controls above the first card. *@
        <div class="cast-actions">
        <RadzenSelectBar TValue="RoleFilter" @bind-Value="_filter" Size="ButtonSize.Small" aria-label="Show">
            <Items>
                <RadzenSelectBarItem Text="All" Value="RoleFilter.All" />
                <RadzenSelectBarItem Text="Husbands" Value="RoleFilter.Husbands" />
                <RadzenSelectBarItem Text="Wives" Value="RoleFilter.Wives" />
            </Items>
        </RadzenSelectBar>
        <RadzenTextBox Value="@_find" @oninput="@(e => _find = e.Value?.ToString() ?? string.Empty)" Name="find" MaxLength="40"
                       Placeholder="Find in the cast" aria-label="Find in the cast" class="cast-find" />
        <RadzenButton Text="Load default cast" Icon="groups" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@SeedAsync" IsBusy="@_seeding" BusyText="Loading…" />
        </div>
    </Actions>
    <ChildContent>
        @if (_loading)
        {
            <LoadingRows Count="6" Label="Loading the cast" />
        }
        else if (_error is not null)
        {
            <PageAlert Kind="AlertStyle.Danger">@_error</PageAlert>
        }
        else if (_profiles.Count == 0)
        {
            <EmptyState Icon="groups" Title="No profiles yet" Text="The default cast is added when the app starts, and everybody who plays joins it. Load it now if it is missing.">
                <Action>
                    <RadzenButton Text="Load default cast" Icon="groups" ButtonStyle="ButtonStyle.Secondary" Variant="Variant.Outlined" Click="@SeedAsync" IsBusy="@_seeding" BusyText="Loading…" />
                </Action>
            </EmptyState>
        }
        else
        {
            @foreach (var (role, label, chip) in Sections)
            {
                var members = _profiles.Where(p => p.Persona.Role == role).Where(Found).OrderBy(p => p.Persona.Name ?? p.Persona.Initials, StringComparer.OrdinalIgnoreCase).ToList();
                if (members.Count == 0)
                {
                    continue;
                }

                <section class="cast" aria-label="@label">
                    <div class="section-head">
                        @* The chip is the section's heading, so it is one: the cards below it are h3, and without
                           this the outline went from the page title straight to them. *@
                        <h2 class="po-chip @chip">@label</h2>
                        <span class="po-muted po-num">@members.Count</span>
                    </div>
                    <RadzenDataList TItem="ProfileDto" Data="@members" WrapItems="true" AllowPaging="false" class="cards">
                        <Template Context="profile">
                            <ProfileCard Profile="@profile" FaceVersion="@_stamp" />
                        </Template>
                    </RadzenDataList>
                </section>
            }
        }
    </ChildContent>
</PageShell>

@code {
    private enum RoleFilter
    {
        All,
        Husbands,
        Wives,
    }

    private List<ProfileDto> _profiles = [];
    private bool _loading = true;
    private bool _seeding;
    private string? _error;
    private RoleFilter _filter = RoleFilter.All;
    private string _find = string.Empty;

    /// <summary>Whether a persona's initials, name or occupation has what was typed in it. Everybody, when nothing was.</summary>
    private bool Found(ProfileDto profile) =>
        _find.Trim() is not { Length: > 0 } find
        || profile.Persona.Initials.Contains(find, StringComparison.OrdinalIgnoreCase)
        || (profile.Persona.Name ?? string.Empty).Contains(find, StringComparison.OrdinalIgnoreCase)
        || (profile.Persona.Occupation ?? string.Empty).Contains(find, StringComparison.OrdinalIgnoreCase);
    private string _stamp = string.Empty;

    private IEnumerable<(ProfileRole Role, string Label, string Chip)> Sections
    {
        get
        {
            if (_filter is RoleFilter.All or RoleFilter.Husbands)
            {
                yield return (ProfileRole.Husband, "Husbands", "po-chip--p1");
            }

            if (_filter is RoleFilter.All or RoleFilter.Wives)
            {
                yield return (ProfileRole.Wife, "Wives", "po-chip--p2");
            }
        }
    }

    protected override Task OnInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _profiles = [.. await Api.GetProfilesAsync()];
            _stamp = Clock.GetUtcNow().ToUnixTimeMilliseconds().ToString(System.Globalization.CultureInfo.InvariantCulture);
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "Could not load the cast") is { } why)
        {
            _error = why;
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SeedAsync()
    {
        var confirmed = await Dialog.Confirm(
            "Reset to the default cast? Every other profile is removed, including the ones written from play (they come back after that person's next match; their records stay).",
            "Load default cast",
            new ConfirmOptions { OkButtonText = "Load cast", CancelButtonText = "Not now" });
        if (confirmed != true)
        {
            return;
        }

        _seeding = true;
        try
        {
            var result = await Api.SeedProfilesAsync();
            Notify.Notify(NotificationSeverity.Success, "Cast loaded", $"{result.Seeded} personas, {result.Faces} with a portrait; {result.Removed} others removed.");
            await LoadAsync();
        }
        catch (ApiException ex)
        {
            Notify.Notify(NotificationSeverity.Error, ex.Status == 403 ? "Not allowed" : "Could not load the cast", ex.Summary);
        }
        finally
        {
            _seeding = false;
        }
    }
}
