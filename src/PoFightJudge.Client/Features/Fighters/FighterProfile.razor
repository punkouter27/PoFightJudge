@page "/fighters/{Tag}"
@using System.Globalization
@using PoFightJudge.Client.Features.Stats
@inject IApiClient Api
@inject NavigationManager Nav
@inject DialogService Dialogs
@inject NotificationService Notifications

@inject Viewport Viewport
@inject Blazored.LocalStorage.ILocalStorageService Storage
@inject IServiceProvider Services
@implements IDisposable

<PageTitle>@Title · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="Fighter" Title="@Title" Lead="@Lead">
    <Actions>
        <RadzenButton Text="All fighters" Icon="groups" ButtonStyle="ButtonStyle.Base" Variant="Variant.Outlined"
                      Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo("fighters"))" />
    </Actions>
    <ChildContent>
        @* A wrapper this page owns, and nothing more (display: contents). Scoped CSS reaches into a child component
           only from an element written here: without one, every ::deep rule for this page matches nothing. *@
        <div class="po-scope">
        @if (_loading)
        {
            <LoadingRows Count="4" Label="Reading their record" />
        }
        else if (_failed is not null)
        {
            <PageAlert Kind="AlertStyle.Danger">@_failed</PageAlert>
            <RadzenButton Text="Try again" Icon="refresh" ButtonStyle="ButtonStyle.Primary" Click="@LoadAsync" />
        }
        else if (_profile is null)
        {
            <EmptyState Icon="person_off" Title="No such fighter" Text="Nobody has argued under that tag." />
        }
        else
        {
            <div class="head po-card">
                <div class="who">
                    <span class="tag po-display">@_profile.Fighter.Tag</span>
                    <RadzenTextBox @bind-Value="_name" Placeholder="Give them a name" MaxLength="40" aria-label="Display name" class="name" />
                    <RadzenButton Text="Save name" Icon="save" ButtonStyle="ButtonStyle.Primary" Variant="Variant.Flat" Size="ButtonSize.Small"
                                  Disabled="@(!CanRename)" Click="RenameAsync" />
                </div>
                <RadzenButton Icon="delete" Text="Forget them" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small"
                              Click="ForgetAsync" />
            </div>

            <div class="record po-card">
                <div class="tally">
                    <span class="big po-display">@_profile.Stats.Wins<span class="of">of @_profile.Stats.Fights</span></span>
                    <span class="po-muted">won, @_profile.Stats.Losses lost@(_profile.Stats.Draws > 0 ? $", {_profile.Stats.Draws} drawn" : string.Empty)</span>
                </div>
                <div class="form">
                    <span class="po-eyebrow">Form</span>
                    <FormSparkline Scores="@_profile.Stats.Form" />
                </div>
                <dl class="facts">
                    <div><dt>Rating</dt><dd>@_profile.Stats.Rating <RankBadge Rating="@_profile.Stats.Rating" Fights="@_profile.Stats.Fights" Promoted="@_promoted" /></dd></div>
                    <div><dt>Average score</dt><dd>@_profile.Stats.AverageScore.ToString("0.#", CultureInfo.CurrentCulture)</dd></div>
                    <div><dt>Best night</dt><dd>@_profile.Stats.BestScore</dd></div>
                    <div><dt>Run</dt><dd>@Run</dd></div>
                    @if (_profile.Stats.TopRival is { } rival)
                    {
                        <div>
                            <dt>Argues most with</dt>
                            <dd>
                                @* The series is a page of its own; the record here is the reason to open it. *@
                                <RadzenLink Path="@($"vs/{_profile.Fighter.Tag}/{rival.Opponent}")" Text="@rival.Opponent" />
                                <span class="po-muted">(@rival.Wins–@rival.Losses over @rival.Fights)</span>
                            </dd>
                        </div>
                    }
                </dl>
                @if (_profile.Stats.Badges.Count > 0)
                {
                    <div class="badges">
                        @foreach (var badge in _profile.Stats.Badges)
                        {
                            <span class="po-chip po-chip--accent">@badge</span>
                        }
                    </div>
                }
            </div>

            <StyleProfilePanel Style="@_profile.Style" />

            @* Counted, not read. The panel above is a model's opinion of how they argue; this is arithmetic on the
               words themselves, and it is only worth a heading once somebody has actually said something. *@
            @if (!_profile.Words.IsEmpty)
            {
                <h2 class="po-display section">How they talk</h2>
                <p class="po-muted counted">
                    Counted across @(_profile.Words.Debates == 1 ? "one fight" : $"{_profile.Words.Debates} fights").
                    Rates are per hundred words, so turning up more often does not inflate them.
                </p>
                @foreach (var group in new[] { StatGroup.Words, StatGroup.Manner })
                {
                    <div class="stats">
                        @foreach (var stat in CareerStatFormat.Describe(_profile.Words).Where(s => s.Group == group))
                        {
                            <StatTile Stat="@stat" />
                        }
                    </div>
                }
            }

            <h2 class="po-display section">What they argued</h2>
            @if (_results.Count == 0)
            {
                <EmptyState Icon="history" Title="Nothing on the record" Text="Their debates will appear here once one has been read." />
            }
            else
            {
                <RadzenDataGrid Data="@_results" TItem="FighterResultDto" AllowSorting="true" AllowPaging="true" PageSize="10" Density="Density.Compact" class="results">
                    <Columns>
                        @* 33rem of declared width on a 356 px screen. Stacked on a phone, the same five facts. *@
                        <RadzenDataGridColumn TItem="FighterResultDto" Title="Result" Visible="@Viewport.IsPhone" Sortable="false">
                            <Template Context="row">
                                <div class="po-stacked">
                                    <span class="po-stacked__head">
                                        <ModeBadge Mode="@row.Mode" />
                                        <span class="po-stacked__strong">@StatFormat.Topic(row.Topic)</span>
                                    </span>
                                    <span class="po-stacked__fine po-muted">
                                        vs @row.Opponent · @(row.Draw ? "draw" : row.Won ? "won" : "lost") @row.Score
                                        · @row.At.LocalDateTime.ToString("d MMM, HH:mm", CultureInfo.CurrentCulture)
                                    </span>
                                </div>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="FighterResultDto" Title="When" Width="10rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterResultDto.At)">
                            <Template Context="row">@row.At.LocalDateTime.ToString("d MMM, HH:mm", CultureInfo.CurrentCulture)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="FighterResultDto" Title="Kind" Width="8rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                            <Template Context="row"><ModeBadge Mode="@row.Mode" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="FighterResultDto" Title="Against" Width="8rem" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterResultDto.Opponent)" />
                        <RadzenDataGridColumn TItem="FighterResultDto" Title="About" Visible="@(!Viewport.IsPhone)" Property="@nameof(FighterResultDto.Topic)">
                            <Template Context="row">@StatFormat.Topic(row.Topic)</Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="FighterResultDto" Title="Result" Width="8rem" Visible="@(!Viewport.IsPhone)" Sortable="false">
                            <Template Context="row">@(row.Draw ? "Draw" : row.Won ? "Won" : "Lost") <span class="po-muted">@row.Score</span></Template>
                        </RadzenDataGridColumn>
                    </Columns>
                </RadzenDataGrid>
            }
        }
        </div>
    </ChildContent>
</PageShell>

@code {
    private FighterProfileDto? _profile;
    private IReadOnlyList<FighterResultDto> _results = [];
    private string? _name;
    private bool _loading = true;

    /// <summary>Why the record could not be read, when that — and not an unknown tag — is what happened.</summary>
    private string? _failed;

    [Parameter] public string Tag { get; set; } = string.Empty;

    private string Title => _profile is null
        ? Initials.Normalize(Tag)
        : string.Equals(_profile.Fighter.DisplayName, _profile.Fighter.Tag, StringComparison.Ordinal)
            ? _profile.Fighter.Tag
            : _profile.Fighter.DisplayName;

    private string Lead => _profile is null
        ? "Nobody has argued under that tag."
        : $"Everything {Title} has argued, counted from the debates themselves.";

    /// <summary>Only a change worth saving enables the button; a blank name is a way of clearing one.</summary>
    private bool CanRename => _profile is not null && !string.Equals(_name ?? string.Empty, _profile.Fighter.DisplayName, StringComparison.Ordinal);

    private string Run => _profile!.Stats.Streak switch
    {
        0 => "—",
        > 0 => $"won {_profile.Stats.Streak} in a row",
        _ => $"lost {-_profile.Stats.Streak} in a row",
    };

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();
    }

    /// <summary>Which columns exist is a render decision, and a rotated phone is a different set of them.</summary>
    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    protected override Task OnParametersSetAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _loading = true;
        _failed = null;
        if (!Initials.IsValid(Tag))
        {
            _profile = null;
            _loading = false;
            return;
        }

        try
        {
            _profile = await Api.GetFighterProfileAsync(FighterId.From(Initials.Normalize(Tag)));
            _results = _profile is null ? [] : [.. _profile.Results.OrderByDescending(r => r.At)];
            _name = _profile?.Fighter.DisplayName;
            await CheckTierAsync();
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "Their record could not be read") is { } why)
        {
            // Not the same as nobody: the tag may be perfectly real and the network not.
            _profile = null;
            _failed = why;
        }
        finally
        {
            _loading = false;
        }
    }

    /// <summary>They have climbed a tier since this page was last looked at, on this browser.</summary>
    private bool _promoted;

    private bool _celebrated;

    /// <summary>Whose tier has been measured, so a page that loads twice does not find the climb already spent.</summary>
    private string? _measured;

    /// <summary>
    /// Measures their tier against the last one this browser saw for them, and remembers the new one. The first look
    /// at anybody is not a climb: there is nothing to have climbed from.
    /// </summary>
    private async Task CheckTierAsync()
    {
        if (_profile is null || string.Equals(_measured, _profile.Fighter.Tag, StringComparison.Ordinal))
        {
            return;
        }

        _measured = _profile.Fighter.Tag;
        var key = $"po-tier-{_profile.Fighter.Tag}";
        var now = RankTiers.For(_profile.Stats.Rating, _profile.Stats.Fights);
        try
        {
            var stored = (await Storage.GetItemAsStringAsync(key))?.Trim('"');
            _promoted = RankTiers.Promoted(Enum.TryParse<Tier>(stored, out var before) ? before : null, now);
            await Storage.SetItemAsStringAsync(key, now.ToString());
        }
        catch (Exception ex) when (ex is Microsoft.JSInterop.JSException or InvalidOperationException)
        {
            // Storage blocked: nothing to compare against, so nothing to celebrate.
        }
    }

    /// <summary>A climb is announced once the badge is on the page: the level-up, and sparks thrown off it.</summary>
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_promoted || _celebrated)
        {
            return;
        }

        _celebrated = true;
        await Services.CueAsync(Sfx.LevelUp);
        if (Services.GetService(typeof(ParticleInterop)) is ParticleInterop particles)
        {
            await particles.BurstAsync(".record", ParticleInterop.Sparks, ".tier");
        }
    }

    private async Task RenameAsync()
    {
        if (_profile is null)
        {
            return;
        }

        try
        {
            // The tag never moves: it is what every result on this page is keyed on.
            var renamed = await Api.RenameFighterAsync(FighterId.From(_profile.Fighter.Tag), _name);
            _profile = _profile with { Fighter = renamed };
            _name = renamed.DisplayName;
            Notifications.Notify(NotificationSeverity.Success, "Saved", $"{renamed.Tag} is now {renamed.DisplayName}.");
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Not saved", ex.Summary);
        }
    }

    private async Task ForgetAsync()
    {
        if (_profile is null)
        {
            return;
        }

        var confirmed = await Dialogs.Confirm(
            $"This clears the record of {_profile.Fighter.Tag} and everything read about how they argue. The debates themselves stay: somebody else argued in them too.",
            "Forget this fighter?",
            new ConfirmOptions { OkButtonText = "Forget them", CancelButtonText = "Keep them" });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteFighterAsync(FighterId.From(_profile.Fighter.Tag));
            Nav.NavigateTo("fighters");
        }
        catch (ApiException ex)
        {
            Notifications.Notify(NotificationSeverity.Error, "Not forgotten", ex.Summary);
        }
    }

    public void Dispose() => Viewport.Changed -= OnViewportChanged;
}
