@page "/"

<PageTitle>PoFightJudge</PageTitle>

<Backdrop Shader="@Shaders.Swarm" />

<PageShell Width="PageShell.ShellWidth.Standard">
    @* The three channels, and beside them the cast and the leaderboard. History follows a match. The title stays
       for a screen reader, which needs the page to open on one. *@
    <h1 class="po-sr-only">PoFightJudge: pick a channel</h1>

    <div class="channels">
        <ChannelCard Number="CPU" Title="CPU vs CPU" Icon="theaters" Href="cpu" Cta="Pick the two" Accent="ChannelCard.ChannelAccent.P1"
                     Description="Two profiles argue; a judge rules. You watch." />
        <ChannelCard Number="1P" Title="1P" Icon="record_voice_over" Href="1p" Cta="Take a side" Accent="ChannelCard.ChannelAccent.P2"
                     Description="You take a seat. A profile takes the other." />
        <ChannelCard Number="2P" Title="2P" Icon="mic" Href="2p" Cta="Both of you" Accent="ChannelCard.ChannelAccent.Accent"
                     Description="Two people, one microphone, a judge between you." />
        <ChannelCard Number="CAST" Title="Profiles" Icon="groups" Href="profiles" Cta="See the cast" Accent="ChannelCard.ChannelAccent.Accent"
                     Description="Everyone who argues here, and how they have done." />
        <ChannelCard Number="TOP" Title="Leaderboard" Icon="emoji_events" Href="fighters" Cta="Who is winning" Accent="ChannelCard.ChannelAccent.Accent"
                     Description="People and the cast, ranked together." />
    </div>
</PageShell>
