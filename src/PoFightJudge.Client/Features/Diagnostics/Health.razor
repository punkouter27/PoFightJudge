@page "/diag"
@page "/status"
@attribute [AllowAnonymous]
@inject IApiClient Api
@inject Viewport Viewport
@inject TimeProvider Clock
@implements IDisposable

<PageTitle>System status · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="Diagnostics" Title="System status" Lead="Whether the app and everything it depends on is working right now. Settings are shown as set or not set, never their values.">
    <Actions>
        <RadzenButton Text="@(_loading ? "Refreshing…" : "Refresh")" Icon="refresh" ButtonStyle="ButtonStyle.Secondary" Click="RefreshAsync" IsBusy="@_loading" Disabled="@_loading" />
    </Actions>
    <ChildContent>
        @* A wrapper this page owns, and nothing more (display: contents). Scoped CSS reaches into a child component
           only from an element written here: without one, every ::deep rule for this page matches nothing. *@
        <div class="po-scope">
        @if (_error is not null)
        {
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="banner" data-testid="diag-banner">
                <strong>The app's server is not answering.</strong> @_error Try Refresh in a minute.
            </RadzenAlert>
            <section aria-labelledby="diag-api">
                <h2 id="diag-api">API</h2>
                <RadzenCard class="row po-diag__card">
                    <span class="name">Reachable</span>
                    <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text="No" class="po-badge po-badge--bad" />
                </RadzenCard>
            </section>
        }
        else if (_report is null)
        {
            <div class="loading" role="status">
                <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Primary" Value="100" ShowValue="false" Mode="ProgressBarMode.Indeterminate" />
                <span class="po-muted">Checking everything…</span>
            </div>
        }
        else
        {
            <RadzenAlert AlertStyle="@Alert(_report.Overall)" Variant="Variant.Flat" Shade="Shade.Lighter" AllowClose="false" class="banner" data-testid="diag-banner">
                <strong>@Headline(_report.Overall)</strong>
                <span class="po-muted"> Last checked @_report.Timestamp.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture) UTC.</span>
            </RadzenAlert>

            <section aria-labelledby="diag-api">
                <h2 id="diag-api">API</h2>
                <RadzenCard class="row po-diag__card">
                    <span class="what">
                        <span class="name">The app's server</span>
                        <span class="po-muted purpose">Answers every page and runs the fights.</span>
                    </span>
                    <span class="facts">
                        <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="Reachable" class="po-badge po-badge--ok" />
                        <span class="po-muted">@Ms(_apiMs)</span>
                    </span>
                </RadzenCard>
            </section>

            <section aria-labelledby="diag-storage">
                <h2 id="diag-storage">Data</h2>
                @{ var stores = Rows(HealthCategory.Storage); }
                @if (stores.Count == 0)
                {
                    <p class="po-muted">No data store is checked in this environment.</p>
                }
                @foreach (var row in stores)
                {
                    <RadzenCard class="row po-diag__card">
                        <span class="what">
                            <span class="name">@row.Name</span>
                            @if (row.Purpose is { Length: > 0 })
                            {
                                <span class="po-muted purpose">@row.Purpose</span>
                            }
                        </span>
                        <span class="facts">
                            <RadzenBadge BadgeStyle="@Style(row.State)" Text="@Word(row.State)" class="@($"po-badge po-badge--{Badge(row.State)}")" />
                            <span class="po-muted">@Ms(row.LatencyMs)</span>
                        </span>
                    </RadzenCard>
                }
            </section>

            <section aria-labelledby="diag-services">
                <h2 id="diag-services">Services</h2>
                @{ var services = Rows(HealthCategory.Service); }
                @if (services.Count == 0)
                {
                    <p class="po-muted">No outside service is checked in this environment.</p>
                }
                @foreach (var row in services)
                {
                    <RadzenCard class="row po-diag__card">
                        <span class="what">
                            <span class="name">@row.Name</span>
                            @if (row.Purpose is { Length: > 0 })
                            {
                                <span class="po-muted purpose">@row.Purpose</span>
                            }
                            <span class="po-muted detail">@row.Detail</span>
                        </span>
                        <span class="facts">
                            <RadzenBadge BadgeStyle="@Style(row.State)" Text="@Word(row.State)" class="@($"po-badge po-badge--{Badge(row.State)}")" />
                            <span class="po-muted">@Ms(row.LatencyMs) · checked @_report.Timestamp.ToString("HH:mm:ss", System.Globalization.CultureInfo.InvariantCulture)</span>
                        </span>
                    </RadzenCard>
                }
            </section>

            <section aria-labelledby="diag-settings">
                <h2 id="diag-settings">Settings</h2>
                <RadzenDataGrid TItem="HealthCheckDto" Data="@Settings" AllowPaging="true" PageSize="20" AllowSorting="true" Density="Density.Compact" class="grid">
                    <Columns>
                        @* On a phone the detail moves under the name it belongs to rather than off the side of the table. *@
                        <RadzenDataGridColumn TItem="HealthCheckDto" Property="@nameof(HealthCheckDto.Name)" Title="Setting" Width="@(Viewport.IsPhone ? "62%" : "16rem")">
                            <Template Context="row">
                                <span class="check">
                                    <span class="name">@row.Name</span>
                                    @if (Viewport.IsPhone && row.Detail is { Length: > 0 })
                                    {
                                        <span class="detail po-muted">@row.Detail</span>
                                    }
                                </span>
                            </Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="HealthCheckDto" Property="@nameof(HealthCheckDto.State)" Title="State" Width="@(Viewport.IsPhone ? "38%" : "9rem")">
                            <Template Context="row"><RadzenBadge BadgeStyle="@Style(row.State)" Text="@Word(row.State)" /></Template>
                        </RadzenDataGridColumn>
                        <RadzenDataGridColumn TItem="HealthCheckDto" Property="@nameof(HealthCheckDto.Detail)" Title="Detail" Visible="@(!Viewport.IsPhone)" />
                    </Columns>
                </RadzenDataGrid>
            </section>
        }
        <p class="po-muted about">Version v@(BuildStamp.Version) · @(_report?.Environment ?? "environment unknown")</p>
        </div>
    </ChildContent>
</PageShell>

@code {
    private HealthReportDto? _report;
    private string? _error;
    // True from the start: the first render happens before the first check has even been sent.
    private bool _loading = true;
    private double? _apiMs;

    private IReadOnlyList<HealthCheckDto> Settings =>
        _report?.Checks.Where(c => c.Category is HealthCategory.Configuration or HealthCategory.Feature).ToList() ?? [];

    protected override async Task OnInitializedAsync()
    {
        Viewport.Changed += OnViewportChanged;
        await Viewport.InitializeAsync();
        await LoadAsync();
    }

    /// <summary>The button: one check at a time, and the button stays disabled until it is back.</summary>
    private async Task RefreshAsync()
    {
        if (_loading)
        {
            return;
        }

        _loading = true;
        await LoadAsync();
    }

    private void OnViewportChanged(object? sender, EventArgs e) => InvokeAsync(StateHasChanged);

    public void Dispose() => Viewport.Changed -= OnViewportChanged;

    private async Task LoadAsync()
    {
        _error = null;
        try
        {
            var started = Clock.GetTimestamp();
            _report = await Api.GetHealthDetailsAsync();
            _apiMs = Math.Round(Clock.GetElapsedTime(started).TotalMilliseconds);
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "The API did not answer") is { } why)
        {
            _report = null;
            _error = why;
        }
        finally
        {
            _loading = false;
        }
    }

    private List<HealthCheckDto> Rows(HealthCategory category) =>
        _report?.Checks.Where(c => c.Category == category).ToList() ?? [];

    private static string Ms(double? ms) => ms is { } value
        ? string.Create(System.Globalization.CultureInfo.InvariantCulture, $"{value:0} ms")
        : "no live check";

    private static string Headline(HealthState overall) => overall switch
    {
        HealthState.Ok => "Everything is working.",
        HealthState.Degraded => "The app works, but something is slow or only partly answering.",
        HealthState.NotConfigured => "The app works; some optional parts are not set up here.",
        _ => "Something the app needs is not working.",
    };

    private static string Word(HealthState state) => state switch
    {
        HealthState.Ok => "Healthy",
        HealthState.Degraded => "Degraded",
        HealthState.NotConfigured => "Not set up",
        _ => "Unhealthy",
    };

    /// <summary>The Po badge modifier (po-tokens.css): ok, warn or bad.</summary>
    private static string Badge(HealthState state) => state switch
    {
        HealthState.Ok => "ok",
        HealthState.Failed => "bad",
        _ => "warn",
    };

    private static AlertStyle Alert(HealthState state) => state switch
    {
        HealthState.Ok => AlertStyle.Success,
        HealthState.Failed => AlertStyle.Danger,
        _ => AlertStyle.Warning,
    };

    private static BadgeStyle Style(HealthState state) => state switch
    {
        HealthState.Ok => BadgeStyle.Success,
        HealthState.Degraded => BadgeStyle.Warning,
        HealthState.NotConfigured => BadgeStyle.Light,
        _ => BadgeStyle.Danger,
    };
}
