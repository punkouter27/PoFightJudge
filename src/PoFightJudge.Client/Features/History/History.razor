@page "/history"
@using System.Globalization
@inject IApiClient Api
@inject NavigationManager Nav
@inject DialogService Dialogs
@inject SetupMemory Memory
@implements IDisposable

<PageTitle>History · PoFightJudge</PageTitle>

<PageShell Width="PageShell.ShellWidth.Standard" Eyebrow="On the record" Title="History"
           Lead="Every argument you have been part of, both kinds, newest first.">
    <ChildContent>
        @* A wrapper this page owns, and nothing more (display: contents). Scoped CSS reaches into a child component
           only from an element written here: without one, every ::deep rule for this page matches nothing. *@
        <div class="po-scope">
        @* Narrowing happens on the server: the browser never holds the whole history, only the page it is showing.
           One row: the kind, the words, and a button for the rest. Two date pickers and an order are asked for
           rarely, and they were half the row every time. *@
        <section class="narrow" aria-label="Narrow the list">
            <RadzenSelectBar @bind-Value="_mode" TValue="MatchMode?" Change="@(_ => NarrowAsync())" Size="ButtonSize.Small" aria-label="Which kind of argument">
                <Items>
                    <RadzenSelectBarItem Text="All" Value="@((MatchMode?)null)" />
                    <RadzenSelectBarItem Text="Watches" Value="@((MatchMode?)MatchMode.Watch)" />
                    <RadzenSelectBarItem Text="Fights" Value="@((MatchMode?)MatchMode.Fight)" />
                </Items>
            </RadzenSelectBar>
            <div class="find">
                <RadzenTextBox Value="@_text" @oninput="@OnTextTyped" Name="find" MaxLength="80"
                               Placeholder="Search a topic, a name or a tag" aria-label="Search your history" />
            </div>
            <RadzenButton Text="@(Refinements > 0 ? $"Filters · {Refinements}" : "Filters")" Icon="tune" ButtonStyle="ButtonStyle.Base"
                          Variant="@(_filters ? Variant.Flat : Variant.Outlined)" Size="ButtonSize.Small"
                          aria-expanded="@(_filters ? "true" : "false")" aria-controls="history-filters" Click="@(() => _filters = !_filters)" />
            @if (IsNarrowed)
            {
                <RadzenButton Text="Clear" Icon="close" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                              Size="ButtonSize.Small" Click="@ClearAsync" />
            }
        </section>
        @if (_filters)
        {
            <section class="filters" id="history-filters" aria-label="More filters">
                <RadzenFormField Text="From" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenDatePicker @bind-Value="_from" Change="@(_ => NarrowAsync())" Name="from" DateFormat="d MMM yyyy"
                                          AllowClear="true" ShowTime="false" aria-label="Earliest date" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="To" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenDatePicker @bind-Value="_to" Change="@(_ => NarrowAsync())" Name="to" DateFormat="d MMM yyyy"
                                          AllowClear="true" ShowTime="false" aria-label="Latest date" />
                    </ChildContent>
                </RadzenFormField>
                <RadzenFormField Text="Order" Variant="Variant.Outlined">
                    <ChildContent>
                        <RadzenDropDown TValue="MatchSort" Value="@_sort" Data="@Orders" TextProperty="Text" ValueProperty="Value"
                                        Change="@(v => SortAsync((MatchSort)v))" Name="order" aria-label="Order" />
                    </ChildContent>
                </RadzenFormField>
            </section>
        }

        @if (_error is not null)
        {
            @* Above the list, not instead of it: a delete that failed must not take the whole history off screen. *@
            <RadzenAlert AlertStyle="AlertStyle.Danger" Variant="Variant.Flat" Shade="Shade.Lighter" Close="@(() => _error = null)">@_error</RadzenAlert>
        }

        @* The placeholder is for the first read only. After that the list stays where it is and says it is busy:
           swapping it out on every page click and every letter typed made the page jump and lost the pager's place. *@
        @if (!_loaded)
        {
            <LoadingRows Count="3" Label="Loading your history" />
        }
        else if (_matches.Count == 0 && _loading)
        {
            <LoadingRows Count="3" Label="Loading your history" />
        }
        else if (_matches.Count == 0 && IsNarrowed)
        {
            <EmptyState Icon="search_off" Title="Nothing matches that" Text="Try a different word, or a wider stretch of time.">
                <Action>
                    <RadzenButton Text="Clear the search" Icon="close" ButtonStyle="ButtonStyle.Primary" Click="@ClearAsync" />
                </Action>
            </EmptyState>
        }
        else if (_matches.Count == 0)
        {
            <EmptyState Icon="history" Title="Nothing yet" Text="Argue with somebody and it will show up here.">
                <Action>
                    <RadzenButton Text="Start a fight" Icon="mic" ButtonStyle="ButtonStyle.Primary" Click="@(() => Nav.NavigateTo("fight"))" />
                </Action>
            </EmptyState>
        }
        else
        {
            @* A card per argument, the same on every screen: what it was about, who, when and who took it, with what
               can be done about it on the same line. The table it replaces had six columns on a desktop and one
               stacked column on a phone — two layouts of the same five facts. Count and PageSize come from the
               server; the pager only appears when there is a second page. *@
            <RadzenDataList Data="@_matches" TItem="MatchDto" AllowPaging="true" IsLoading="@_loading" Count="@_total" PageSize="@_take"
                            WrapItems="false" LoadData="@OnPageAsync" class="history">
                <Template Context="match">
                    <article class="match po-card">
                        <div class="line">
                            <ModeBadge Mode="@match.Mode" />
                            <h2 class="topic">@StatFormat.Topic(match.Topic)</h2>
                            <span class="when po-muted">@match.StartedAt.LocalDateTime.ToString("d MMM, HH:mm", CultureInfo.CurrentCulture)</span>
                        </div>
                        <div class="line">
                            <span class="who po-muted">@match.Side1.DisplayName vs @match.Side2.DisplayName</span>
                            <span class="result">
                                @if (match.IsDraw)
                                {
                                    <span class="po-muted">Nobody took it</span>
                                }
                                else
                                {
                                    <strong>@match.Winner</strong>
                                }
                                @if (match.IsFake)
                                {
                                    <span class="po-chip" title="Argued with no key, so nothing here was really judged.">rehearsal</span>
                                }
                            </span>
                            <span class="row-actions">
                                @if (match.Mode == MatchMode.Fight)
                                {
                                    <RadzenButton Text="Open" Icon="description" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                  Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo($"verdict/{match.Id.Value}"))" />
                                }
                                else
                                {
                                    <RadzenButton Text="Replay" Icon="play_arrow" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text"
                                                  Size="ButtonSize.Small" Click="@(() => Nav.NavigateTo($"watch/replay/{match.Id.Value}"))" />
                                }
                                <RadzenButton Icon="replay" ButtonStyle="ButtonStyle.Base" Variant="Variant.Text" Size="ButtonSize.Small"
                                              title="@($"Argue {StatFormat.Topic(match.Topic)} again")" aria-label="@($"Argue {StatFormat.Topic(match.Topic)} again")"
                                              Click="@(() => RunItBackAsync(match))" />
                                <RadzenButton Icon="delete" ButtonStyle="ButtonStyle.Danger" Variant="Variant.Text" Size="ButtonSize.Small"
                                              title="@($"Delete {StatFormat.Topic(match.Topic)}")" aria-label="@($"Delete {StatFormat.Topic(match.Topic)}")" Click="@(() => ConfirmAsync(match))" />
                            </span>
                        </div>
                    </article>
                </Template>
            </RadzenDataList>
        }
        </div>
    </ChildContent>
</PageShell>

@code {
    [Inject] private IServiceProvider Services { get; set; } = default!;

    /// <summary>How long to wait after the last keystroke before asking. Short enough to feel live, long enough that
    /// typing a word is one request rather than five.</summary>
    private static readonly TimeSpan TypingPause = TimeSpan.FromMilliseconds(300);

    private readonly CancellationTokenSource _leaving = new();
    private IReadOnlyList<MatchDto> _matches = [];
    private MatchMode? _mode;
    private string _text = string.Empty;
    private DateTime? _from;
    private DateTime? _to;
    private int _skip;
    private int _take = MatchQuery.DefaultTake;
    private int _total;
    private MatchSort _sort = MatchSort.Newest;

    /// <summary>False until the first answer is in: the only time there is nothing on screen to keep in place.</summary>
    private bool _loaded;

    /// <summary>Whether the dates and the order are showing.</summary>
    private bool _filters;

    /// <summary>The orders the server can give, in the words the dropdown shows.</summary>
    private static readonly IReadOnlyList<(string Text, MatchSort Value)> OrderChoices =
    [
        ("Newest first", MatchSort.Newest),
        ("Oldest first", MatchSort.Oldest),
        ("Topic, A to Z", MatchSort.TopicAscending),
        ("Topic, Z to A", MatchSort.TopicDescending),
    ];

    private static readonly IEnumerable<object> Orders = [.. OrderChoices.Select(o => new { o.Text, o.Value })];

    /// <summary>How many of the things behind the Filters button are set, so a closed panel still says so.</summary>
    private int Refinements => (_from is null ? 0 : 1) + (_to is null ? 0 : 1) + (_sort == MatchSort.Newest ? 0 : 1);
    private CancellationTokenSource? _typing;
    private bool _loading = true;
    private string? _error;

    /// <summary>Whether anything has been asked of the list. Decides which empty state is the true one.</summary>
    private bool IsNarrowed => _mode is not null || _text.Trim().Length > 0 || _from is not null || _to is not null;

    protected override async Task OnInitializedAsync()
    {
        ReadAddress();
        _filters = Refinements > 0;
        await LoadAsync();
    }

    public void Dispose()
    {
        _leaving.Cancel();
        _leaving.Dispose();
        _typing?.Dispose();
    }

    private async Task LoadAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            // The To date is a day, and somebody who picks it means the end of it rather than midnight at its start.
            var page = await Api.GetMatchPageAsync(
                new MatchQuery(_mode, _text, _from, _to?.Date.AddDays(1).AddTicks(-1), _skip, _take, _sort),
                _leaving.Token);

            _matches = page.Matches;
            _total = page.Total;
            WriteAddress();
        }
        catch (OperationCanceledException)
        {
            // Left the page, or a newer keystroke replaced this request.
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "Your history could not be loaded") is { } why)
        {
            _error = why;
        }
        finally
        {
            _loading = false;
            _loaded = true;
        }
    }

    /// <summary>
    /// What is being asked for lives in the address as well as on the page, so coming back from an argument, a
    /// reload, or a link somebody saved all open the same list rather than the first page of everything.
    /// </summary>
    private void ReadAddress()
    {
        var asked = System.Web.HttpUtility.ParseQueryString(new Uri(Nav.Uri).Query);
        _text = asked["find"] ?? string.Empty;
        _mode = Enum.TryParse<MatchMode>(asked["kind"], ignoreCase: true, out var mode) ? mode : null;
        _sort = Enum.TryParse<MatchSort>(asked["sort"], ignoreCase: true, out var sort) ? sort : MatchSort.Newest;
        _from = DateTime.TryParseExact(asked["from"], "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var from) ? from : null;
        _to = DateTime.TryParseExact(asked["to"], "yyyy-MM-dd", CultureInfo.InvariantCulture, DateTimeStyles.None, out var to) ? to : null;
        _skip = int.TryParse(asked["skip"], NumberStyles.None, CultureInfo.InvariantCulture, out var skip) ? skip : 0;
    }

    /// <summary>Replaces the entry rather than adding one: Back should leave the page, not undo a letter of a search.</summary>
    private void WriteAddress()
    {
        var address = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>(StringComparer.Ordinal)
        {
            ["find"] = _text.Trim().Length == 0 ? null : _text.Trim(),
            ["kind"] = _mode?.ToString().ToLowerInvariant(),
            ["sort"] = _sort == MatchSort.Newest ? null : _sort.ToString(),
            ["from"] = _from?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["to"] = _to?.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture),
            ["skip"] = _skip == 0 ? null : _skip,
        });

        if (!string.Equals(address, Nav.Uri, StringComparison.Ordinal))
        {
            Nav.NavigateTo(address, replace: true);
        }
    }

    /// <summary>Any change to what is being asked for starts again at the first page: page four of a new search is nowhere.</summary>
    private Task NarrowAsync()
    {
        _skip = 0;
        return LoadAsync();
    }

    /// <summary>
    /// Typing is debounced rather than sent per keystroke. The pause is cancelled by the next letter, so a word typed
    /// at speed is one request; nothing is dropped, because the last letter always wins.
    /// </summary>
    private async Task OnTextTyped(ChangeEventArgs e)
    {
        _text = e.Value?.ToString() ?? string.Empty;

        var previous = _typing;
        _typing = CancellationTokenSource.CreateLinkedTokenSource(_leaving.Token);
        if (previous is not null)
        {
            await previous.CancelAsync();
            previous.Dispose();
        }

        try
        {
            await Task.Delay(TypingPause, _typing.Token);
        }
        catch (OperationCanceledException)
        {
            return;
        }

        await NarrowAsync();
        StateHasChanged();
    }

    private Task ClearAsync()
    {
        _mode = null;
        _text = string.Empty;
        _from = null;
        _to = null;
        _sort = MatchSort.Newest;
        return NarrowAsync();
    }

    /// <summary>A new order is a new list: page four of it is somewhere else entirely.</summary>
    private Task SortAsync(MatchSort sort)
    {
        _sort = sort;
        return NarrowAsync();
    }

    /// <summary>The list asking for a page. The list is the server's, so the page is asked of it.</summary>
    private Task OnPageAsync(LoadDataArgs args)
    {
        var skip = args.Skip ?? 0;
        if (skip == _skip && _loaded)
        {
            // The list asks again whenever it is handed a new one. Nothing it wants has changed.
            return Task.CompletedTask;
        }

        _skip = skip;
        return LoadAsync();
    }

    /// <summary>
    /// The same matchup, set up again. It fills the setup screen in rather than starting anything: a side can be a
    /// person, and nothing here should be able to put a result on somebody's record without them pressing start.
    /// </summary>
    private async Task RunItBackAsync(MatchDto match)
    {
        if (match.Mode == MatchMode.Fight)
        {
            // The seats and the host are not on the record. If these are the two who fought last on this device,
            // they get what they chose then; anybody else starts from the usual.
            var last = await Memory.LastFightAsync();
            var same = last is not null
                && string.Equals(last.One, match.Side1.Id, StringComparison.OrdinalIgnoreCase)
                && string.Equals(last.Two, match.Side2.Id, StringComparison.OrdinalIgnoreCase);
            Memory.Rematch(new FightCard(
                match.Side1.Id,
                match.Side2.Id,
                match.Topic,
                same ? last!.OneRole : ProfileRole.Husband,
                same ? last!.TwoRole : ProfileRole.Wife,
                same ? last!.Persona : HostPersonaId.Referee) { OneStance = match.Side1Stance });
            Nav.NavigateTo("2p");
            return;
        }

        var person = match.Side1.IsHuman ? match.Side1 : match.Side2.IsHuman ? match.Side2 : null;
        Memory.Rematch(new WatchCard(
            match.Side1.IsHuman ? string.Empty : match.Side1.Id,
            match.Side2.IsHuman ? string.Empty : match.Side2.Id,
            match.Topic,
            person?.Id ?? string.Empty));
        Nav.NavigateTo(person is null ? "cpu" : "1p");
    }

    /// <summary>
    /// Deleting takes the recording and both sides' records with it, so it is worth asking first — this is the one
    /// destructive thing on the page.
    /// </summary>
    private async Task ConfirmAsync(MatchDto match)
    {
        var confirmed = await Dialogs.Confirm(
            $"This removes the recording, the transcript and both sides' records of {match.Side1.DisplayName} against {match.Side2.DisplayName}. It cannot be undone.",
            "Delete this argument?",
            new ConfirmOptions { OkButtonText = "Delete", CancelButtonText = "Keep it" });

        if (confirmed != true)
        {
            return;
        }

        try
        {
            await Api.DeleteMatchAsync(match.Id);

            // Struck from the record.
            await Services.CueAsync(Sfx.Gavel);

            // A new list rather than a removal: the list is bound to the instance, and it re-reads when it changes.
            _matches = [.. _matches.Where(m => m.Id != match.Id)];
            _total = Math.Max(0, _total - 1);

            // The last row of a page that is not the first: there is more history, and it is one page back.
            if (_matches.Count == 0 && _total > 0)
            {
                _skip = Math.Max(0, _skip - _take);
                await LoadAsync();
            }
        }
        catch (Exception ex) when (ApiFailure.Describe(ex, "It could not be deleted") is { } why)
        {
            _error = why;
        }
    }
}
