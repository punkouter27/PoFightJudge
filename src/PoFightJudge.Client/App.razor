@implements IDisposable
@inject NavigationManager Nav
@inject ThemeInterop Theme
@* The theme follows the device (Po web standard): ThemeInterop swaps material <-> material-dark to match it. *@
<RadzenTheme Theme="material-dark" />
<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    <RedirectToLogin />
                </NotAuthorized>
                <Authorizing>
                    <p class="po-boot">Checking sign-in…</p>
                </Authorizing>
            </AuthorizeRouteView>
            @* Focus moves to the new page's h1 only once the user has followed a link. On a fresh load (and the app's own
               redirects, such as / to /login) nothing is focused, so Tab opens the Po developer window
               (js/po-devwindow.js). *@
            @if (_userNavigated)
            {
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            }
        </Found>
        <NotFound>
            <LayoutView Layout="@typeof(Layout.BareLayout)">
                <PoFightJudge.Client.Layout.NotFound />
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private bool _userNavigated;

    protected override async Task OnInitializedAsync()
    {
        Nav.LocationChanged += OnLocationChanged;
        await Theme.InitializeAsync();
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_userNavigated || !e.IsNavigationIntercepted)
        {
            return;
        }

        _userNavigated = true;
        StateHasChanged();
    }

    public void Dispose() => Nav.LocationChanged -= OnLocationChanged;
}
