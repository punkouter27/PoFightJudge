<?xml version="1.0" encoding="UTF-8" ?>
<Shell xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
       xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
       xmlns:pages="clr-namespace:PoFightJudge.Mobile.Pages"
       x:Class="PoFightJudge.Mobile.AppShell"
       Title="PoFightJudge">

    <TabBar>
        <ShellContent Title="Live Fight" Route="fight" ContentTemplate="{DataTemplate pages:LiveFightPage}" />
        <ShellContent Title="Verdicts" Route="history" ContentTemplate="{DataTemplate pages:HistoryPage}" />
        <ShellContent Title="Settings" Route="settings" ContentTemplate="{DataTemplate pages:SettingsPage}" />
    </TabBar>

</Shell>
