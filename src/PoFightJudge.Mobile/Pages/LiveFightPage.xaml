<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoFightJudge.Mobile.Pages.LiveFightPage"
             Title="Live Fight">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="PoFightJudge Live Stage" FontSize="24" FontAttributes="Bold" />
            <Label x:Name="StatusLabel" Text="One microphone, two fighters. Keep screen awake during debate." FontSize="13" />

            <Border Padding="14" StrokeThickness="1" StrokeShape="RoundRectangle 10">
                <VerticalStackLayout Spacing="8">
                    <Label Text="Match Setup" FontAttributes="Bold" />
                    <Entry x:Name="Player1Entry" Placeholder="Player 1 Tag (e.g. MAT)" Text="MAT" MaxLength="3" />
                    <Entry x:Name="Player2Entry" Placeholder="Player 2 Tag (e.g. JIL)" Text="JIL" MaxLength="3" />
                    <Entry x:Name="TopicEntry" Placeholder="Debate topic" Text="Who leaves wet towels on the bed?" />
                    <HorizontalStackLayout Spacing="10">
                        <Switch x:Name="WakeSwitch" IsToggled="True" />
                        <Label Text="Hardware WakeLock + Haptic turn cues" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </VerticalStackLayout>
            </Border>

            <HorizontalStackLayout Spacing="10">
                <Button x:Name="MicCheckButton" Text="Grant Mic Permission" Clicked="OnMicCheckClicked" />
                <Button x:Name="StartFightButton" Text="Start Fight" Clicked="OnStartFightClicked" />
                <Button x:Name="EndFightButton" Text="End Fight" Clicked="OnEndFightClicked" IsEnabled="False" />
            </HorizontalStackLayout>

            <Label Text="Live Captions (SignalR)" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="CaptionsList" Spacing="4" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
