<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="PoFightJudge.Mobile.Pages.HistoryPage"
             Title="Verdicts &amp; Elo">
    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="12">
            <Label Text="Verdicts &amp; Leaderboard" FontSize="22" FontAttributes="Bold" />
            <Button Text="Refresh (Offline-Cached)" Clicked="OnRefreshClicked" />
            <Label x:Name="StatusLabel" FontSize="12" />
            <Label Text="Recent Matches" FontAttributes="Bold" />
            <VerticalStackLayout x:Name="MatchesList" Spacing="8" />
            <Label Text="Elo Leaderboard" FontAttributes="Bold" Margin="0,10,0,0" />
            <VerticalStackLayout x:Name="LeaderboardList" Spacing="4" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
